# Home Manager mappings for files adopted out of $HOME.
#
# This file is generated and appended to by `dot adopt`. It is imported by
# home/default.nix so the adoption command can remain compatible with existing
# private profiles while modular profiles store payloads under home/files/.
#
# Edit adopted files under home/files/ and run `dot rebuild`. Use
# `dot adopt --mutable` for files an application rewrites itself.
{ config, ... }:

{
  home.file = {
    # dot-adopt:entries — new mappings are inserted directly above this line.
  };
}
