.DS_Store
**/.DS_Store
*.swp
*.swo
*.bak
.direnv/
result
result-*
node_modules/
.env
.env.*
!.env.example
config/local/
secrets/

# Unmanaged Zsh escape hatches, sourced last by config/zsh/custom.zsh.
# The tracked .example alongside is the template; the real files are yours.
.zshrc.local
config/zsh/custom.local.zsh

# Modular local-settings layer (machine identity, app selections).
# May be a real directory or a symlink to ~/dotfiles-private.
.local
.local/

# Machine-local agent tool state (permission allowlists with absolute paths).
# Must be ignored in the committed config, not just in .git/info/exclude:
# `dot validate` fails on untracked files under agent directories, so a
# machine-local exclude made validation pass here and fail on a fresh clone.
**/config.local.json
.claude/settings.local.json
