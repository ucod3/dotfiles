#!/usr/bin/env bash
set -euo pipefail

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
cd "$(dotfiles_root)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found."
  echo "Install it with: brew install gitleaks"
  exit 1
fi

exec gitleaks detect \
  --source . \
  --config .gitleaks.toml \
  --redact