#!/usr/bin/env bash
#
# scan-secrets — run gitleaks over a repository with this repo's ruleset.
#
# Usage:
#   dot secrets                      # scan ~/dotfiles (the default)
#   dot secrets ~/dotfiles-private   # scan any other repository
#
# The optional path exists because the private flake is the repository that
# actually holds user config, and `dot promote` now publishes it — so promote
# needs to scan a directory that is not this one before pushing. The config is
# always THIS repo's .gitleaks.toml regardless of what is being scanned: it
# carries the `[extend] useDefault` stanza, without which gitleaks loads an
# empty ruleset and every scan trivially passes (ADR-006).
#
set -euo pipefail

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
DOTFILES_ROOT="$(dotfiles_root)"

case "${1:-}" in
  -h | --help)
    echo "Usage: scan-secrets [PATH]"
    echo ""
    echo "Scans PATH (default: $DOTFILES_ROOT) with $DOTFILES_ROOT/.gitleaks.toml."
    exit 0
    ;;
esac

SOURCE="${1:-$DOTFILES_ROOT}"

[[ -d "$SOURCE" ]] || { echo "scan-secrets: not a directory: $SOURCE" >&2; exit 1; }

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found."
  echo "Install it with: brew install gitleaks"
  exit 1
fi

exec gitleaks detect \
  --source "$SOURCE" \
  --config "$DOTFILES_ROOT/.gitleaks.toml" \
  --redact