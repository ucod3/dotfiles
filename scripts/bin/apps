#!/usr/bin/env bash
#
# apps - Manage applications in the active private profile
#
# Usage:
#   apps list
#   apps search <name>
#   apps add <name>
#   apps add --cask <name>
#   apps add --nix <attribute>
#   apps add --mas <name> <id-or-app-store-url>
#   apps remove <name>
#   apps edit [casks|nix|mas]
#

set -euo pipefail

# ── Paths and output ────────────────────────────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"

DOTFILES_ROOT="$(dotfiles_root)"
PRIVATE_ROOT="$(private_flake_root)"
LOCAL_DIR="$(local_dir)"
FRAMEWORK_CONFIG="$DOTFILES_ROOT/hosts/default.nix"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
BOLD='\033[1m'

section() { echo -e "\n${BLUE}${BOLD}$1${NC}"; }
info()    { echo -e "  ${CYAN}→${NC} $1"; }
ok()      { echo -e "  ${GREEN}✓${NC} $1"; }
warn()    { echo -e "  ${YELLOW}!${NC} $1"; }
err()     { echo -e "  ${RED}✗${NC} $1"; }

visible_path() {
  local path="$1"
  if [[ "$path" == "$HOME"/* ]]; then
    printf '%s/%s\n' '~' "${path#"$HOME"/}"
  else
    printf '%s\n' "$path"
  fi
}

# A modular profile is identified by the composition file generated for the
# readable apps/ layout. Existing profiles without it stay on the legacy
# .local/ compatibility path.
if [[ -f "$PRIVATE_ROOT/apps/default.nix" ]]; then
  PROFILE_LAYOUT="modular"
  CASKS_FILE="$PRIVATE_ROOT/apps/homebrew-casks.nix"
  NIX_FILE="$PRIVATE_ROOT/apps/nix-packages.nix"
  MAS_FILE="$PRIVATE_ROOT/apps/mac-app-store.nix"
else
  PROFILE_LAYOUT="legacy"
  APPS_FILE="$LOCAL_DIR/apps.nix"
  SETTINGS_FILE="$LOCAL_DIR/settings.nix"
fi

# ── Read helpers ────────────────────────────────────────────────────────────

# Legacy files contain keyed lists and may put several entries on one line.
# This compatibility reader is intentionally limited to string lists.
legacy_list_read_file() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  python3 - "$file" "$key" <<'PYEOF'
import re
import sys

path, key = sys.argv[1], sys.argv[2]
try:
    text = open(path, encoding="utf-8").read()
except OSError:
    sys.exit(0)


def collect(start):
    i, depth, out = start, 1, []
    while i < len(text) and depth > 0:
        c = text[i]
        if c == "#":
            newline = text.find("\n", i)
            i = len(text) if newline == -1 else newline
        elif c == '"':
            j, value = i + 1, []
            while j < len(text) and text[j] != '"':
                if text[j] == "\\" and j + 1 < len(text):
                    value.append(text[j + 1])
                    j += 2
                    continue
                value.append(text[j])
                j += 1
            out.append("".join(value))
            i = j + 1
        else:
            if c == "[":
                depth += 1
            elif c == "]":
                depth -= 1
            i += 1
    return out


for match in re.finditer(
    r"(?:^|[\s{;])(?:homebrew\.)?" + re.escape(key) + r"\s*=\s*\[",
    text,
):
    for entry in collect(match.end()):
        if entry:
            print(entry)
PYEOF
}

legacy_selection_read() {
  local key="$1" file
  for file in "$APPS_FILE" "$SETTINGS_FILE"; do
    legacy_list_read_file "$file" "$key"
  done | awk 'NF && !seen[$0]++'
}

legacy_generated_read() {
  legacy_list_read_file "$APPS_FILE" "$1"
}

modular_casks_read() {
  [[ -f "$CASKS_FILE" ]] || return 0
  sed -nE 's/^[[:space:]]*"([^"]+)"[[:space:]]*$/\1/p' "$CASKS_FILE"
}

modular_nix_read() {
  [[ -f "$NIX_FILE" ]] || return 0
  sed -nE 's/^[[:space:]]*pkgs\.([^[:space:]#]+)[[:space:]]*$/\1/p' "$NIX_FILE"
}

modular_mas_read() {
  [[ -f "$MAS_FILE" ]] || return 0
  sed -E '/^[[:space:]]*#/d' "$MAS_FILE" | sed -nE \
    's/^[[:space:]]*"?([^"=]+)"?[[:space:]]*=[[:space:]]*([0-9]+);[[:space:]]*$/\1  (ID: \2)/p'
}

legacy_mas_read() {
  python3 - "$APPS_FILE" "$SETTINGS_FILE" <<'PYEOF'
import re
import sys

seen = set()
for path in sys.argv[1:]:
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        continue
    match = re.search(r"masApps\s*=\s*\{", text)
    if not match:
        continue
    depth, i, block = 1, match.end(), []
    while i < len(text) and depth > 0:
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        block.append(text[i])
        i += 1
    for line in "".join(block).splitlines():
        if line.lstrip().startswith("#"):
            continue
        pair = re.match(r'\s*"?([^"=]+)"?\s*=\s*(\d+)\s*;', line)
        if pair and pair.group(1).strip() not in seen:
            name = pair.group(1).strip()
            seen.add(name)
            print(f"{name}  (ID: {pair.group(2)})")
PYEOF
}

casks_read() {
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    modular_casks_read
  else
    legacy_selection_read casks
  fi
}

nix_packages_read() {
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    modular_nix_read
  else
    legacy_selection_read nixPackages
  fi
}

mas_apps_read() {
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    modular_mas_read
  else
    legacy_mas_read
  fi
}

print_entries() {
  local any=false line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    any=true
    printf '      %s\n' "$line"
  done
  [[ "$any" == true ]] || printf '      (none)\n'
}

contains_line() {
  local needle="$1"
  while IFS= read -r entry; do
    [[ "$entry" == "$needle" ]] && return 0
  done
  return 1
}

# ── Write helpers ───────────────────────────────────────────────────────────

# Insert an ordinary Nix list entry immediately before the closing bracket.
# Generated modular files deliberately use this simple shape. If an owner turns
# the file into a more advanced expression, the command refuses to guess and
# points them to the hand-edit path.
require_simple_modular_file() {
  local kind="$1" file="$2" line trimmed
  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue

    case "$kind" in
      cask)
        [[ "$trimmed" == "[" || "$trimmed" == "]" ||
          "$trimmed" =~ ^\"[a-zA-Z0-9@._+-]+\"$ ]] && continue
        ;;
      nix)
        [[ "$trimmed" == "{ pkgs }:" || "$trimmed" == "[" || "$trimmed" == "]" ||
          "$trimmed" =~ ^pkgs\.[a-zA-Z0-9@._+-]+$ ]] && continue
        ;;
      mas)
        [[ "$trimmed" == "{" || "$trimmed" == "}" ||
          "$trimmed" =~ ^\"[a-zA-Z0-9@._+\ -]+\"[[:space:]]*=[[:space:]]*[0-9]+\;$ ]] &&
          continue
        ;;
    esac

    err "$(visible_path "$file") no longer has the generated plain $kind shape."
    info "The command will not parse or rewrite advanced Nix. Edit it directly:"
    info "  dot apps edit $kind"
    return 1
  done < "$file"
}

plain_list_add() {
  local kind="$1" file="$2" entry="$3" temp
  [[ -f "$file" ]] || {
    err "Missing application file: $(visible_path "$file")"
    return 1
  }
  require_simple_modular_file "$kind" "$file"

  temp="$(mktemp "${file}.tmp.XXXXXX")"
  if ! awk -v entry="$entry" '
    /^[[:space:]]*][[:space:]]*$/ && !inserted {
      print "  " entry
      inserted = 1
    }
    { print }
    END { if (!inserted) exit 42 }
  ' "$file" > "$temp"; then
    rm -f "$temp"
    err "Could not find the plain list boundary in $(visible_path "$file")"
    info "Open it with: dot apps edit"
    return 1
  fi
  chmod 0644 "$temp"
  mv "$temp" "$file"
}

plain_attrset_add() {
  local file="$1" entry="$2" temp
  [[ -f "$file" ]] || {
    err "Missing application file: $(visible_path "$file")"
    return 1
  }
  require_simple_modular_file mas "$file"

  temp="$(mktemp "${file}.tmp.XXXXXX")"
  if ! awk -v entry="$entry" '
    /^[[:space:]]*}[[:space:]]*$/ && !inserted {
      print "  " entry
      inserted = 1
    }
    { print }
    END { if (!inserted) exit 42 }
  ' "$file" > "$temp"; then
    rm -f "$temp"
    err "Could not find the plain attribute-set boundary in $(visible_path "$file")"
    info "Open it with: dot apps edit mas"
    return 1
  fi
  chmod 0644 "$temp"
  mv "$temp" "$file"
}

plain_entry_remove() {
  local kind="$1" file="$2" entry="$3" temp
  require_simple_modular_file "$kind" "$file"
  temp="$(mktemp "${file}.tmp.XXXXXX")"
  if ! awk -v target="$entry" '
    {
      normalized = $0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", normalized)
      if (normalized == target) {
        found = 1
        next
      }
      print
    }
    END { if (!found) exit 43 }
  ' "$file" > "$temp"; then
    rm -f "$temp"
    return 1
  fi
  chmod 0644 "$temp"
  mv "$temp" "$file"
}

legacy_apps_write() {
  local cask package
  mkdir -p "$LOCAL_DIR"
  {
    echo "# .local/apps.nix — generated by \`dot apps\`. Do not hand-edit:"
    echo "# this file is rewritten wholesale on every add/remove."
    echo "# Hand-written selections belong in .local/settings.nix."
    echo "{"
    echo "  casks = ["
    for cask in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"}; do
      [[ -n "$cask" ]] && printf '    "%s"\n' "$cask"
    done
    echo "  ];"
    echo "  nixPackages = ["
    for package in ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
      [[ -n "$package" ]] && printf '    "%s"\n' "$package"
    done
    echo "  ];"
    echo "}"
  } > "$APPS_FILE"
}

validate_name() {
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z0-9@._+-]+$ ]] || {
    err "Invalid package name: '$name'"
    info "Use only letters, numbers, @, ., _, +, and -."
    return 1
  }
}

validate_mas_name() {
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z0-9@._+\ -]+$ ]] || {
    err "Invalid Mac App Store name: '$name'"
    info "Use only letters, numbers, spaces, @, ., _, +, and -."
    return 1
  }
}

validate_after_mutation() {
  local changed_file="$1"
  [[ "${DOTFILES_APPS_SKIP_VALIDATE:-0}" == "1" ]] && return 0

  echo ""
  info "Checking $(visible_path "$changed_file")..."
  if command -v nix-instantiate >/dev/null 2>&1; then
    if nix-instantiate --parse "$changed_file" >/dev/null 2>&1; then
      ok "Nix syntax is valid"
    else
      err "Nix syntax validation failed"
      warn "Review the file before rebuilding: $(visible_path "$changed_file")"
      return 1
    fi
  else
    warn "nix-instantiate is unavailable; syntax check skipped"
  fi

  if [[ "$PROFILE_LAYOUT" == "legacy" && -x "$DOTFILES_ROOT/scripts/bin/validate" ]]; then
    "$DOTFILES_ROOT/scripts/bin/validate" --quick
  fi
}

show_manual_change() {
  local action="$1" expression="$2" file="$3"
  echo ""
  info "Equivalent manual change:"
  printf '    %s %s in %s\n' "$action" "$expression" "$(visible_path "$file")"
  echo ""
  info "Review with:"
  printf '    git -C %s diff -- %s\n' \
    "$(visible_path "$PRIVATE_ROOT")" "${file#"$PRIVATE_ROOT"/}"
  info "Apply with: ${BOLD}dot rebuild${NC}"
}

# ── Commands ───────────────────────────────────────────────────────────────

cmd_list() {
  section "Declared Applications"
  echo ""
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    echo -e "  ${BOLD}Active source:${NC} $(visible_path "$PRIVATE_ROOT") (modular profile)"
  else
    echo -e "  ${BOLD}Active source:${NC} $(visible_path "$LOCAL_DIR") (legacy compatibility)"
  fi

  echo ""
  echo -e "    ${CYAN}Homebrew casks${NC}"
  casks_read | print_entries
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    printf '      File: %s\n' "$(visible_path "$CASKS_FILE")"
  fi

  echo ""
  echo -e "    ${CYAN}Nix packages${NC}"
  nix_packages_read | print_entries
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    printf '      File: %s\n' "$(visible_path "$NIX_FILE")"
  fi

  echo ""
  echo -e "    ${CYAN}Mac App Store${NC}"
  mas_apps_read | print_entries
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    printf '      File: %s\n' "$(visible_path "$MAS_FILE")"
  fi

  echo ""
  echo -e "  ${BOLD}Framework core${NC} (Nix, always installed)"
  python3 - "$FRAMEWORK_CONFIG" <<'PYEOF' | awk 'NF && !seen[$0]++ { print "      " $0 }'
import re
import sys

inside = False
with open(sys.argv[1], encoding="utf-8") as source:
    for line in source:
        if re.search(r"systemPackages\s*=\s*(with\s+pkgs;\s*)?\[", line):
            inside = True
            continue
        if inside and re.search(r"^\s*\]", line):
            inside = False
            continue
        if inside:
            value = line.strip()
            if value and not value.startswith("#"):
                name = value.split()[0].removeprefix("pkgs.")
                if re.match(r"^[a-z]", name):
                    print(name)
PYEOF
  echo ""
}

cmd_search() {
  local query="${1:-}"
  [[ -n "$query" ]] || {
    err "Usage: apps search <name>"
    exit 1
  }

  section "Search results for: $query"
  echo ""
  echo -e "  ${BOLD}Homebrew casks${NC}"
  if command -v brew >/dev/null 2>&1 &&
    brew search --cask "$query" 2>/dev/null | head -8 | grep -v '^$'; then
    true
  else
    info "Homebrew is unavailable or found no local result."
  fi
  info "Official search: https://formulae.brew.sh/cask/"

  echo ""
  echo -e "  ${BOLD}Nix packages${NC}"
  info "Official search: https://search.nixos.org/packages"
  info "Use the package attribute shown there (for example: ripgrep)."
  echo ""
  echo -e "  ${BOLD}Mac App Store${NC}"
  info "Find the app in the App Store, choose Copy Link, and paste that URL."
  info "A numeric App Store ID still works too."
  echo ""
  info "Search changes nothing. Add only the result you reviewed."
  echo ""
}

normalize_mas_reference() {
  local reference="$1"
  if [[ "$reference" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$reference"
    return 0
  fi

  if [[ "$reference" =~ ^https://apps\.apple\.com/ ]] &&
     [[ "$reference" =~ /id([0-9]+)($|[/?#]) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi

  return 1
}

modular_add() {
  local kind="$1" name="$2" id="${3:-}" file expression
  case "$kind" in
    cask)
      file="$CASKS_FILE"
      if modular_casks_read | contains_line "$name"; then
        warn "'$name' is already declared in $(visible_path "$file")"
        return 0
      fi
      expression="\"$name\""
      plain_list_add cask "$file" "$expression"
      ;;
    nix)
      file="$NIX_FILE"
      if modular_nix_read | contains_line "$name"; then
        warn "'pkgs.$name' is already declared in $(visible_path "$file")"
        return 0
      fi
      expression="pkgs.$name"
      plain_list_add nix "$file" "$expression"
      ;;
    mas)
      file="$MAS_FILE"
      if modular_mas_read | sed 's/  (ID:.*//' | contains_line "$name"; then
        warn "'$name' is already declared in $(visible_path "$file")"
        return 0
      fi
      expression="\"$name\" = $id;"
      plain_attrset_add "$file" "$expression"
      ;;
  esac

  ok "Added $expression to $(visible_path "$file")"
  validate_after_mutation "$file"
  show_manual_change "Add" "$expression" "$file"
}

legacy_add() {
  local kind="$1" name="$2"
  local CASKS_OUT=() NIXPKGS_OUT=() entry
  while IFS= read -r entry; do CASKS_OUT+=("$entry"); done < <(legacy_generated_read casks)
  while IFS= read -r entry; do NIXPKGS_OUT+=("$entry"); done < <(legacy_generated_read nixPackages)

  for entry in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"} ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
    if [[ "$entry" == "$name" ]]; then
      warn "'$name' is already declared in $(visible_path "$APPS_FILE")"
      return 0
    fi
  done

  if [[ "$kind" == "cask" ]]; then
    CASKS_OUT+=("$name")
  elif [[ "$kind" == "nix" ]]; then
    NIXPKGS_OUT+=("$name")
  else
    err "Mac App Store additions require a modular private profile."
    info "For this legacy profile, edit $(visible_path "$SETTINGS_FILE") manually."
    return 1
  fi

  legacy_apps_write
  ok "Added '$name' to $(visible_path "$APPS_FILE")"
  validate_after_mutation "$APPS_FILE"
  echo ""
  info "This existing profile remains on the legacy compatibility path."
  info "Apply with: ${BOLD}dot rebuild${NC}"
}

cmd_add() {
  local kind="auto" name="" id=""
  case "${1:-}" in
    --cask)
      kind="cask"
      name="${2:-}"
      ;;
    --nix)
      kind="nix"
      name="${2:-}"
      ;;
    --mas)
      kind="mas"
      name="${2:-}"
      id="${3:-}"
      ;;
    *)
      name="${1:-}"
      ;;
  esac

  [[ -n "$name" ]] || {
    err "Usage: apps add <name> | --cask <name> | --nix <attribute> | --mas <name> <id>"
    exit 1
  }

  if [[ "$kind" == "mas" ]]; then
    validate_mas_name "$name"
    id="$(normalize_mas_reference "$id")" || {
      err "Pass a numeric App Store ID or an https://apps.apple.com/ URL."
      exit 1
    }
  else
    validate_name "$name"
  fi

  section "Adding: $name"
  echo ""

  if [[ "$kind" == "auto" ]]; then
    if ! command -v brew >/dev/null 2>&1; then
      err "Homebrew is unavailable, so the package type cannot be detected."
      info "Use an explicit form: dot apps add --cask $name"
      info "Or: dot apps add --nix $name"
      exit 1
    elif brew info --cask "$name" >/dev/null 2>&1; then
      kind="cask"
      ok "Found as a Homebrew cask"
    elif brew info "$name" >/dev/null 2>&1; then
      warn "'$name' is a Homebrew formula."
      info "Prefer Nix when available: dot apps add --nix <nixpkgs-attribute>"
      info "Search: https://search.nixos.org/packages?query=$name"
      exit 0
    else
      err "Could not find '$name' as a Homebrew cask or formula."
      info "Search first with: dot apps search $name"
      info "Or choose explicitly with --cask, --nix, or --mas."
      exit 1
    fi
  fi

  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    modular_add "$kind" "$name" "$id"
  else
    legacy_add "$kind" "$name"
  fi
}

modular_remove() {
  local name="$1" file="" expression="" record app_name app_id
  if modular_casks_read | contains_line "$name"; then
    file="$CASKS_FILE"
    expression="\"$name\""
  elif modular_nix_read | contains_line "$name"; then
    file="$NIX_FILE"
    expression="pkgs.$name"
  else
    while IFS= read -r record; do
      app_name="${record%  (ID:*}"
      if [[ "$app_name" == "$name" ]]; then
        app_id="${record##*  (ID: }"
        app_id="${app_id%)}"
        file="$MAS_FILE"
        expression="\"$name\" = $app_id;"
        break
      fi
    done < <(modular_mas_read)
  fi

  if [[ -z "$file" ]]; then
    warn "'$name' is not declared in the modular private profile."
    info "Run 'dot apps list' to see the active declarations."
    return 1
  fi

  local kind
  if [[ "$file" == "$CASKS_FILE" ]]; then
    kind="cask"
  elif [[ "$file" == "$NIX_FILE" ]]; then
    kind="nix"
  else
    kind="mas"
  fi
  plain_entry_remove "$kind" "$file" "$expression"
  ok "Removed $expression from $(visible_path "$file")"
  validate_after_mutation "$file"
  show_manual_change "Remove" "$expression" "$file"

  if [[ "$(resolved_cleanup)" == "none" && "$file" == "$CASKS_FILE" ]]; then
    info "Cleanup remains \"none\"; rebuild will not uninstall the existing app."
    info "Remove it manually only when intended: brew uninstall --cask $name"
  fi
}

legacy_remove() {
  local name="$1" found=false entry
  local CASKS_OUT=() NIXPKGS_OUT=() kept=()
  while IFS= read -r entry; do CASKS_OUT+=("$entry"); done < <(legacy_generated_read casks)
  while IFS= read -r entry; do NIXPKGS_OUT+=("$entry"); done < <(legacy_generated_read nixPackages)

  for entry in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"}; do
    if [[ "$entry" == "$name" ]]; then found=true; else kept+=("$entry"); fi
  done
  CASKS_OUT=(${kept[@]+"${kept[@]}"})

  kept=()
  for entry in ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
    if [[ "$entry" == "$name" ]]; then found=true; else kept+=("$entry"); fi
  done
  NIXPKGS_OUT=(${kept[@]+"${kept[@]}"})

  [[ "$found" == true ]] || {
    warn "'$name' is not in the generated legacy selection file."
    info "Hand-written choices in $(visible_path "$SETTINGS_FILE") are never rewritten."
    return 1
  }

  legacy_apps_write
  ok "Removed '$name' from $(visible_path "$APPS_FILE")"
  validate_after_mutation "$APPS_FILE"
  info "Apply with: ${BOLD}dot rebuild${NC}"
}

cmd_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || {
    err "Usage: apps remove <name>"
    exit 1
  }

  section "Removing: $name"
  echo ""
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    modular_remove "$name"
  else
    legacy_remove "$name"
  fi
}

resolved_cleanup() {
  local file
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    file="$PRIVATE_ROOT/apps/default.nix"
  else
    file="$SETTINGS_FILE"
  fi

  if [[ -f "$file" ]] && grep -qE 'homebrew\.cleanup|cleanup[[:space:]]*=' "$file"; then
    sed -nE 's/.*cleanup[[:space:]]*=[[:space:]]*"([a-z]+)".*/\1/p' "$file" | head -1
  else
    echo "none"
  fi
}

cmd_edit() {
  local category="${1:-all}" target
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    case "$category" in
      all) target="$PRIVATE_ROOT/apps" ;;
      casks) target="$CASKS_FILE" ;;
      nix) target="$NIX_FILE" ;;
      mas) target="$MAS_FILE" ;;
      *)
        err "Unknown category '$category'. Use casks, nix, or mas."
        exit 1
        ;;
    esac
  else
    target="$SETTINGS_FILE"
  fi

  info "Opening $(visible_path "$target")..."
  echo ""
  echo "  After editing:"
  echo "    nix-instantiate --parse $(visible_path "$target")"
  echo "    dot rebuild"
  echo ""
  if [[ -z "${EDITOR:-}" ]]; then
    err "\$EDITOR is not set. Open this path directly:"
    echo "    $(visible_path "$target")"
    exit 1
  fi
  "$EDITOR" "$target"
}

cmd_help() {
  local cask_count nix_count mas_count
  cask_count=$(casks_read | grep -c '\S' || true)
  nix_count=$(nix_packages_read | grep -c '\S' || true)
  mas_count=$(mas_apps_read | grep -c '\S' || true)

  echo ""
  echo -e "${BOLD}apps${NC} — Manage applications in your private profile"
  echo ""
  if [[ "$PROFILE_LAYOUT" == "modular" ]]; then
    echo "  Active profile: $(visible_path "$PRIVATE_ROOT") (modular)"
  else
    echo "  Active profile: $(visible_path "$LOCAL_DIR") (legacy compatibility)"
  fi
  echo ""
  echo -e "  ${BOLD}Commands:${NC}"
  echo "    apps list                      List declarations and their files"
  echo "    apps search <name>             Find package names"
  echo "    apps add <name>                Auto-detect a Homebrew cask"
  echo "    apps add --cask <name>         Add a Homebrew GUI application"
  echo "    apps add --nix <attribute>     Add pkgs.<attribute>"
  echo "    apps add --mas <name> <ref>    Add by App Store URL or numeric ID"
  echo "    apps remove <name>             Remove a declaration"
  echo "    apps edit [casks|nix|mas]      Open the owning private file"
  echo ""
  echo -e "  ${BOLD}Current declarations:${NC}"
  printf "    %-22s %s\n" "Homebrew casks" "$cask_count"
  printf "    %-22s %s\n" "Nix packages" "$nix_count"
  printf "    %-22s %s\n" "Mac App Store" "$mas_count"
  echo ""
  echo "  Commands print the exact private file they change and the equivalent"
  echo "  manual Nix edit. Review changes before running: dot rebuild"
  echo ""
}

case "${1:-}" in
  list)    cmd_list ;;
  search)  cmd_search "${2:-}" ;;
  add)     cmd_add "${@:2}" ;;
  remove)  cmd_remove "${2:-}" ;;
  edit)    cmd_edit "${2:-}" ;;
  help|--help|-h|"") cmd_help ;;
  *)
    err "Unknown apps command: '${1:-}'"
    cmd_help
    exit 1
    ;;
esac
