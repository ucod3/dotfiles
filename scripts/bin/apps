#!/usr/bin/env bash
#
# apps - Manage applications in your dotfiles
#
# Usage:
#   apps                    Show this help and current app counts
#   apps list               List all installed apps by category
#   apps search <name>      Search for an app name to use
#   apps add <name>         Add an app (auto-detects cask vs brew vs nix)
#   apps remove <name>      Remove an app from config
#   apps edit               Open hosts/default.nix directly
#

set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
CONFIG="$DOTFILES_ROOT/hosts/default.nix"

# Optional app-set modules also declare brews/casks/masApps/systemPackages.
# list/add/remove must see them all, but `apps add` only writes to $CONFIG.
APP_MODULES_DIR="$DOTFILES_ROOT/nix/modules/apps"
CONFIG_FILES=("$CONFIG")
if [[ -d "$APP_MODULES_DIR" ]]; then
  for _f in "$APP_MODULES_DIR"/*.nix; do
    [[ -f "$_f" ]] && CONFIG_FILES+=("$_f")
  done
fi

# Colors come from the shared logger; this script keeps its own display verbs
# (section/info/ok/warn/err) because its output style differs from both of
# log.sh's families.
# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
BOLD='\033[1m'

section() { echo -e "\n${BLUE}${BOLD}$1${NC}"; }
info()    { echo -e "  ${CYAN}→${NC} $1"; }
ok()      { echo -e "  ${GREEN}✓${NC} $1"; }
warn()    { echo -e "  ${YELLOW}!${NC} $1"; }
err()     { echo -e "  ${RED}✗${NC} $1"; }

# ── The user's app selections live in .local/apps.nix ───────────────────────
# `apps add/remove` owns this file exclusively: it is machine-generated and
# round-tripped, never hand-edited. It used to sed a `casks = [` block inside
# hosts/default.nix, but the de-opinionated refactor replaced that block with
# `casks = dotfilesLocal.casks;` — so the sed matched nothing, changed nothing,
# and still printed "✓ Added". lib/local.nix merges apps.nix into the cask and
# package lists. Hand-written selections belong in .local/settings.nix.
LOCAL_DIR="${DOTFILES_LOCAL:-$DOTFILES_ROOT/.local}"
APPS_FILE="$LOCAL_DIR/apps.nix"

# Read one generated list (casks|nixPackages); prints one entry per line.
apps_file_read() {
  [[ -f "$APPS_FILE" ]] || return 0
  awk -v key="$1" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\\[" { inblock = 1; next }
    inblock && /^[[:space:]]*\];/ { inblock = 0; next }
    inblock && match($0, /"[^"]+"/) { print substr($0, RSTART + 1, RLENGTH - 2) }
  ' "$APPS_FILE"
}

# Rewrite apps.nix from the CASKS_OUT / NIXPKGS_OUT arrays.
apps_file_write() {
  mkdir -p "$LOCAL_DIR"
  {
    echo "# .local/apps.nix — generated by \`dot apps\`. Do not hand-edit:"
    echo "# this file is rewritten wholesale on every add/remove."
    echo "# Hand-written selections belong in .local/settings.nix."
    echo "{"
    echo "  casks = ["
    for _c in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"}; do
      [[ -n "$_c" ]] && echo "    \"$_c\""
    done
    echo "  ];"
    echo "  nixPackages = ["
    for _p in ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
      [[ -n "$_p" ]] && echo "    \"$_p\""
    done
    echo "  ];"
    echo "}"
  } > "$APPS_FILE"
}

# Escape special regex characters for sed
sed_escape() {
  printf '%s' "$1" | sed 's/[.\\*^$\[\]/]/\\&/g'
}

# Post-mutation validate — run after every config change
# Catches Nix syntax errors introduced by add/remove before the user rebuilds.
# Prints a git rollback hint on failure; does NOT auto-revert (git is the undo).
validate_after_mutation() {
  local validate_bin="$DOTFILES_ROOT/scripts/bin/validate"

  if [[ ! -x "$validate_bin" ]]; then
    return 0  # validate missing — skip silently
  fi

  echo ""
  info "Validating config after change..."

  local output exit_code
  output=$("$validate_bin" --quick 2>&1) && exit_code=0 || exit_code=$?

  # Always print the output so the user sees check results
  echo "$output"

  if [[ $exit_code -eq 0 ]]; then
    ok "Config is valid — safe to rebuild"
  else
    echo ""
    err "Config validation failed after mutation."
    warn "To undo this change, run:"
    echo "    git checkout -- $CONFIG"
    echo ""
    warn "Fix the error above, then run: dot rebuild"
  fi
}

# ── Commands ───────────────────────────────────────────────────────────────

parse_block() {
  # Extract quoted values from a named block: parse_block "casks" "[" "]"
  # Scans hosts/default.nix plus all nix/modules/apps/*.nix files.
  local name="$1" open="${2:-\[}" close="${3:-\]}"
  python3 - "$name" "$open" "$close" "${CONFIG_FILES[@]}" << 'PYEOF'
import sys, re
name, open_c, close_c = sys.argv[1:4]
for cfg in sys.argv[4:]:
    inside = False
    depth = 0
    for line in open(cfg):
        stripped = line.strip()
        if not inside:
            if re.search(r'^\s*(homebrew\.)?' + re.escape(name) + r'\s*=\s*' + re.escape(open_c), line) and not stripped.startswith('#'):
                inside = True
                depth = 1
                continue
        else:
            depth += line.count(open_c) - line.count(close_c)
            if depth <= 0:
                break
            m = re.match(r'\s*"([^"]+)"', line)
            if m:
                print("    " + m.group(1))
PYEOF
}

cmd_list() {
  section "Installed Apps"

  echo ""
  echo -e "  ${BOLD}Homebrew Casks${NC} (GUI apps)"
  parse_block "casks" "[" "]"

  echo ""
  echo -e "  ${BOLD}Homebrew Brews${NC} (CLI tools)"
  parse_block "brews" "[" "]"

  echo ""
  echo -e "  ${BOLD}Mac App Store${NC}"
  python3 - "${CONFIG_FILES[@]}" << 'PYEOF'
import sys, re
for cfg in sys.argv[1:]:
    inside = False
    for line in open(cfg):
        if re.search(r'masApps\s*=\s*\{', line):
            inside = True
            continue
        if inside:
            if re.search(r'^\s*\}', line):
                break
            # MAS IDs are large numbers (> 100000)
            m = re.match(r'\s+([A-Za-z][A-Za-z0-9 ]+)\s*=\s*(\d{6,})\s*;', line)
            if m:
                print("    " + m.group(1).strip() + "  (ID: " + m.group(2) + ")")
PYEOF

  echo ""
  echo -e "  ${BOLD}Nix Packages${NC} (system)"
  python3 - "${CONFIG_FILES[@]}" << 'PYEOF'
import sys, re
for cfg in sys.argv[1:]:
    inside = False
    for line in open(cfg):
        if re.search(r'systemPackages\s*=\s*(with\s+pkgs;\s*)?\[', line):
            inside = True
            continue
        if inside:
            if re.search(r'^\s*\]', line):
                break
            stripped = line.strip()
            if stripped and not stripped.startswith('#'):
                name = stripped.split()[0].removeprefix('pkgs.')
                if re.match(r'^[a-z]', name):
                    print("    " + name)
PYEOF

  echo ""
}

cmd_search() {
  local query="${1:-}"
  if [[ -z "$query" ]]; then
    err "Usage: apps search <name>"
    echo "  Example: apps search firefox"
    exit 1
  fi

  section "Search results for: $query"

  echo ""
  echo -e "  ${BOLD}Homebrew Casks${NC} (GUI apps — use in 'casks' section):"
  if brew search --cask "$query" 2>/dev/null | head -8 | grep -v '^$'; then
    true
  else
    info "No casks found"
  fi

  echo ""
  echo -e "  ${BOLD}Homebrew Formulas${NC} (CLI tools — use in 'brews' section):"
  if brew search --formula "$query" 2>/dev/null | head -8 | grep -v '^$'; then
    true
  else
    info "No formulas found"
  fi

  echo ""
  echo -e "  ${BOLD}Nix Packages${NC} (use in 'systemPackages' section):"
  info "Search at: ${CYAN}https://search.nixos.org/packages?query=$query${NC}"

  echo ""
  echo -e "  ${BOLD}Mac App Store${NC}:"
  info "Open App Store and search: ${BOLD}$query${NC}"
  info "Get the ID from the app's URL (number at the end)"

  echo ""
  info "Once you know the name, run: ${BOLD}apps add <name>${NC}"
}

cmd_add() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    err "Usage: apps add <name>"
    echo "  Example: apps add firefox"
    echo "  Tip: run 'apps search <name>' first to find the correct name"
    exit 1
  fi

  # Validate package name against safe characters
  if [[ ! "$name" =~ ^[a-zA-Z0-9@._-]+$ ]]; then
    err "Invalid package name: '$name'"
    info "Package names must contain only: letters, numbers, @, ., _, -"
    exit 1
  fi

  section "Adding: $name"
  echo ""

  # Detect what type it is
  local is_cask=false
  local is_brew=false

  if brew info --cask "$name" &>/dev/null; then
    is_cask=true
    ok "Found as Homebrew cask (GUI app)"
  elif brew info "$name" &>/dev/null; then
    is_brew=true
    ok "Found as Homebrew formula (CLI tool)"
  else
    warn "Could not auto-detect package type"
    echo ""
    echo "  Please add manually to hosts/default.nix"
    echo "  Then run: dot rebuild"
    cmd_edit
    exit 0
  fi

  # Already declared by a framework example set? Adding it again would be a
  # duplicate declaration the user cannot then remove via this tool.
  if grep -q "\"$name\"" "${CONFIG_FILES[@]}" 2>/dev/null; then
    warn "'$name' is already declared by a framework app set"
    info "Enable that set in .local/settings.nix rather than adding it here"
    exit 0
  fi

  local CASKS_OUT NIXPKGS_OUT
  # shellcheck disable=SC2207
  CASKS_OUT=($(apps_file_read casks))
  # shellcheck disable=SC2207
  NIXPKGS_OUT=($(apps_file_read nixPackages))

  for _existing in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"} ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
    if [[ "$_existing" == "$name" ]]; then
      warn "'$name' is already in $APPS_FILE"
      exit 0
    fi
  done

  # Both casks and brews are Homebrew concepts; the generated file tracks casks
  # (GUI apps) and Nix packages. A brew formula is better served by nixpkgs, so
  # steer CLI tools there and let the user override if they disagree.
  if [[ "$is_cask" == true ]]; then
    CASKS_OUT+=("$name")
    apps_file_write
    ok "Added '$name' to casks in ${APPS_FILE/#$HOME/\~}"
  elif [[ "$is_brew" == true ]]; then
    warn "'$name' is a Homebrew formula (CLI tool), not a cask."
    info "Prefer the nixpkgs equivalent — check: https://search.nixos.org/packages"
    info "To add it as a Nix package: edit .local/settings.nix nixPackages"
    exit 0
  fi

  validate_after_mutation

  echo ""
  info "Apply the change by running: ${BOLD}dot rebuild${NC}"
  echo ""
  warn "Or to undo: ${BOLD}dot apps remove $name${NC}"
}

cmd_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    err "Usage: apps remove <name>"
    echo "  Example: apps remove firefox"
    exit 1
  fi

  section "Removing: $name"
  echo ""

  local CASKS_OUT NIXPKGS_OUT found=false
  # shellcheck disable=SC2207
  CASKS_OUT=($(apps_file_read casks))
  # shellcheck disable=SC2207
  NIXPKGS_OUT=($(apps_file_read nixPackages))

  local kept=() entry
  for entry in ${CASKS_OUT[@]+"${CASKS_OUT[@]}"}; do
    if [[ "$entry" == "$name" ]]; then found=true; else kept+=("$entry"); fi
  done
  CASKS_OUT=(${kept[@]+"${kept[@]}"})

  kept=()
  for entry in ${NIXPKGS_OUT[@]+"${NIXPKGS_OUT[@]}"}; do
    if [[ "$entry" == "$name" ]]; then found=true; else kept+=("$entry"); fi
  done
  NIXPKGS_OUT=(${kept[@]+"${kept[@]}"})

  if [[ "$found" == false ]]; then
    # Never edit a shipped framework module. Those are the example profiles
    # this repo distributes; mutating them makes the user's checkout diverge
    # from upstream and the change would be lost on the next pull.
    local owner
    owner=$(grep -l "\"$name\"" "${CONFIG_FILES[@]}" 2>/dev/null | head -1 || true)
    if [[ -n "$owner" ]]; then
      warn "'$name' comes from the framework app set ${owner##*/}"
      info "Disable that set in .local/settings.nix, or override it there:"
      info "  dotfiles.apps.<set>.casks = [ ... ];"
      exit 1
    fi
    warn "'$name' not found in your selections"
    info "Run 'dot apps list' to see what's declared"
    exit 1
  fi

  apps_file_write
  ok "Removed '$name' from ${APPS_FILE/#$HOME/\~}"

  validate_after_mutation

  echo ""
  info "Apply the change by running: ${BOLD}dot rebuild${NC}"
  if [[ "$(resolved_cleanup)" == "none" ]]; then
    info "Homebrew cleanup is \"none\", so the app stays installed until you"
    info "remove it manually (brew uninstall --cask $name) or set"
    info "homebrew.cleanup = \"uninstall\" in .local/settings.nix"
  else
    info "The app will be uninstalled during rebuild (cleanup = uninstall)"
  fi
}

# What `homebrew.cleanup` actually resolves to, rather than assuming.
resolved_cleanup() {
  local settings="$LOCAL_DIR/settings.nix"
  if [[ -f "$settings" ]] && grep -qE 'homebrew\.cleanup|cleanup[[:space:]]*=' "$settings"; then
    sed -nE 's/.*cleanup[[:space:]]*=[[:space:]]*"([a-z]+)".*/\1/p' "$settings" | head -1
  else
    echo "none"
  fi
}

cmd_edit() {
  info "Opening hosts/default.nix in your editor..."
  echo ""
  echo "  Sections:"
  echo "    brews      → CLI tools  (https://formulae.brew.sh/formula/)"
  echo "    casks      → GUI apps   (https://formulae.brew.sh/cask/)"
  echo "    masApps    → App Store  (find ID in App Store URL)"
  echo "    systemPackages → Nix    (https://search.nixos.org/packages)"
  echo ""
  echo "  After editing, run: dot rebuild"
  echo ""
  # No editor default beyond $EDITOR: assuming a specific one (this was
  # hardcoded to code-insiders) breaks on any machine that lacks it.
  if [[ -z "${EDITOR:-}" ]]; then
    err "\$EDITOR is not set. Set it, or open the file directly:"
    echo "    $CONFIG"
    exit 1
  fi
  "$EDITOR" "$CONFIG"
}

cmd_help() {
  echo ""
  echo -e "${BOLD}apps${NC} — Manage your installed applications"
  echo ""
  echo -e "  ${BOLD}Commands:${NC}"
  echo "    apps                  Show this help"
  echo "    apps list             List all apps by category"
  echo "    apps search <name>    Find the right package name"
  echo "    apps add <name>       Add an app (auto-detects type)"
  echo "    apps remove <name>    Remove an app from config"
  echo "    apps edit             Open hosts/default.nix directly"
  echo ""
  echo -e "  ${BOLD}Examples:${NC}"
  echo "    apps search firefox   → find firefox package name"
  echo "    apps add firefox      → add to config"
  echo "    apps remove arc       → remove from config"
  echo "    rebuild               → apply changes"
  echo ""
  echo -e "  ${BOLD}Where apps come from:${NC}"
  printf "    %-22s %s\n" "Homebrew casks" "GUI .app bundles   → formulae.brew.sh/cask"
  printf "    %-22s %s\n" "Homebrew brews" "CLI tools          → formulae.brew.sh/formula"
  printf "    %-22s %s\n" "Mac App Store" "Purchased apps     → App Store URL number"
  printf "    %-22s %s\n" "Nix packages" "Cross-platform     → search.nixos.org"
  echo ""
  echo -e "  ${BOLD}Current counts:${NC}"

  local cask_count brew_count nix_count
  cask_count=$(parse_block "casks" "[" "]" | grep -c '\S' || true)
  brew_count=$(parse_block "brews" "[" "]" | grep -c '\S' || true)
  nix_count=$(cmd_list 2>/dev/null | grep -A200 'Nix Packages' | grep -c '^    [a-z]' || true)

  printf "    %-22s %s\n" "Casks (GUI apps)" "$cask_count apps"
  printf "    %-22s %s\n" "Brews (CLI tools)" "$brew_count tools"
  printf "    %-22s %s\n" "Nix packages" "$nix_count packages"
  echo ""
}

# ── Main ───────────────────────────────────────────────────────────────────

case "${1:-}" in
  list)    cmd_list ;;
  search)  cmd_search "${2:-}" ;;
  add)     cmd_add "${2:-}" ;;
  remove)  cmd_remove "${2:-}" ;;
  edit)    cmd_edit ;;
  *)       cmd_help ;;
esac