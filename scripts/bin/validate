#!/usr/bin/env bash
#
# Validation script - run before every commit and rebuild
# Catches errors BEFORE they reach the system
#
# Checks:
#   1. Zsh syntax     - all .zsh modules
#   2. Bash syntax    - scripts via bash -n
#   3. Shell linting  - shellcheck for semantic issues
#   4. Nix syntax     - flake.nix, home.nix, configuration.nix
#   5. Nix flake      - full flake check
#   6. Common mistakes - hardcoded emails, vim.loop, broken paths
#
# Usage:
#   ./scripts/bin/validate          # run all checks
#   ./scripts/bin/validate --quick  # skip slow nix checks
#

set -euo pipefail

# Declare counters BEFORE sourcing lib/log.sh (which uses them)
ERRORS=0
WARNINGS=0

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
cd "$DOTFILES_ROOT"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"

QUICK_MODE=false

[[ "${1:-}" == "--quick" ]] && QUICK_MODE=true

# ── 1. Zsh syntax ──────────────────────────────────────────────────────────
section "Zsh syntax"
for f in config/zsh/modules/*.zsh config/zsh/custom.zsh config/zsh/.zshenv; do
  if [[ -f "$f" ]]; then
    if zsh -n "$f" 2>/dev/null; then
      pass "$f"
    else
      fail "$f — syntax error:"
      zsh -n "$f" 2>&1 | sed 's/^/    /'
    fi
  fi
done

# ── 2. Shell script syntax ─────────────────────────────────────────────────
section "Shell script syntax"
for f in scripts/bin/dot scripts/bin/rebuild scripts/bin/update scripts/bin/validate scripts/bin/apps install.sh; do
  if [[ -f "$f" ]]; then
    if bash -n "$f" 2>/dev/null; then
      pass "$f"
    else
      fail "$f — syntax error:"
      bash -n "$f" 2>&1 | sed 's/^/    /'
    fi
  fi
done

# ── 3. Shell script linting (shellcheck) ────────────────────────────────────
section "Shell script linting"
if command -v shellcheck >/dev/null 2>&1; then
  for f in scripts/bin/dot scripts/bin/rebuild scripts/bin/update scripts/bin/validate scripts/bin/apps install.sh; do
    if [[ -f "$f" ]]; then
      # Run shellcheck with specific exclusions for this codebase
      # SC1090: Can't follow non-constant source (we use dynamic paths)
      # SC1091: Not following sourced file (we check syntax separately)
      if shellcheck --shell=bash --severity=warning --exclude=SC1090,SC1091 "$f" 2>/dev/null; then
        pass "$f"
      else
        warn "$f — shellcheck issues found (see above)"
      fi
    fi
  done
else
  pass "shellcheck not installed — skipping (install with: nix-env -iA nixpkgs.shellcheck)"
fi

# ── 4. Nix syntax ──────────────────────────────────────────────────────────
if [[ "$QUICK_MODE" == false ]]; then
  section "Nix syntax"
  for f in flake.nix nix/home/home.nix hosts/default.nix; do
    if [[ -f "$f" ]]; then
      if nix-instantiate --parse "$f" > /dev/null 2>&1; then
        pass "$f"
      else
        fail "$f — syntax error:"
        nix-instantiate --parse "$f" 2>&1 | sed 's/^/    /'
      fi
    fi
  done
fi

# ── 5. Nix flake check ─────────────────────────────────────────────────────
if [[ "$QUICK_MODE" == false ]]; then
  section "Nix flake check"
  if nix flake check 2>/dev/null; then
    pass "flake.nix is valid"
  else
    # flake check can fail for non-syntax reasons on darwin, treat as warning
    warn "nix flake check had issues (may be non-critical on macOS)"
  fi
fi

# ── 6. Common mistakes ─────────────────────────────────────────────────────
section "Common mistakes"

# Check for deprecated vim.loop (should use vim.uv)
if grep -r "vim\.loop\." config/nvim/ 2>/dev/null | grep -v "vim.uv or vim.loop"; then
  fail "Deprecated vim.loop found in nvim config (use vim.uv or (vim.uv or vim.loop))"
else
  pass "No deprecated vim.loop usage"
fi

# Check for hardcoded personal emails in tracked files (customize regex for your domain)
staged_files=$(git diff --cached --name-only 2>/dev/null)
if [[ -n "$staged_files" ]]; then
  if echo "$staged_files" | xargs grep -lE "[a-z]+\.[a-z]+@[a-z]+\.(com|org|net|io)" 2>/dev/null | grep -v "git/config"; then
    warn "Email addresses found in staged files — verify these are intentional"
  else
    pass "No email addresses in staged files"
  fi
else
  pass "No staged files to check"
fi

# Check for double-quoted $HOME in aliases (expands at source time, not run time)
if grep -n 'alias.*=".*\$HOME' config/zsh/modules/aliases.zsh 2>/dev/null; then
  warn "Double-quoted \$HOME in aliases — these expand at source time. Use single quotes."
else
  pass "Alias quoting is correct"
fi

# Check module paths reference DOTFILES_ROOT not hardcoded paths
if grep -n "/Users/[a-z]" config/zsh/modules/*.zsh config/zsh/custom.zsh 2>/dev/null | grep -v "DOTFILES_ROOT\|HOME"; then
  fail "Hardcoded /Users/ path found in zsh modules — use DOTFILES_ROOT instead"
else
  pass "No hardcoded home paths in zsh modules"
fi

# Check that modules directory path in custom.zsh is dynamic
if grep -q 'DOTFILES_ROOT\|HOME.*dotfiles' config/zsh/custom.zsh 2>/dev/null; then
  pass "Module path in custom.zsh is dynamic"
else
  fail "custom.zsh may have hardcoded module path"
fi

# Portability: rebuild must use dynamic hostname, not a hardcoded flake attribute
if grep -qE 'darwin-rebuild.*#(m4pro|Usmans-M4Pro|My-MacBook|HardcodedHost)' scripts/bin/rebuild 2>/dev/null; then
  fail "rebuild script has a hardcoded hostname — it must use \"\${HOSTNAME}\" dynamically"
else
  pass "rebuild uses dynamic hostname resolution"
fi

# Purity: getEnv in Nix files defeats flake reproducibility
if grep -rn 'builtins\.getEnv' flake.nix hosts/ nix/ 2>/dev/null; then
  fail "builtins.getEnv found in Nix files — this breaks pure evaluation"
else
  pass "No builtins.getEnv in Nix files"
fi

# Portability: flake.nix must delegate to mkHost, not hard-wire a hostname
if grep -q '"m4pro"' flake.nix 2>/dev/null; then
  fail "Stale hardcoded 'm4pro' attribute found in flake.nix"
else
  pass "flake.nix uses dynamic host matrix"
fi

# Check for untracked config files that Nix references
section "Git tracking"
NIX_SOURCES=$(grep -h "source = \.\." nix/home/home.nix hosts/default.nix 2>/dev/null \
  | sed 's/.*source = \.\.\/\.\.\///;s/[";].*//;s/ //g' | sort -u)
while IFS= read -r src; do
  if [[ -n "$src" ]] && ! git ls-files --error-unmatch "$src" 2>/dev/null; then
    fail "Nix references '$src' but it's not tracked by git (run: git add $src)"
  fi
done <<< "$NIX_SOURCES"

# .devin/ rules and skills must always be tracked — untracked files here
# mean a rule or skill will silently not apply on other machines.
UNTRACKED_DEVIN=$(git ls-files --others --exclude-standard .devin/ 2>/dev/null)
if [[ -n "$UNTRACKED_DEVIN" ]]; then
  fail "Untracked .devin/ files — rules/skills won't apply on other machines (run: git add):"
  echo "$UNTRACKED_DEVIN" | sed 's/^/    /'
else
  pass ".devin/ rules and skills are git-tracked"
fi

# Check for any untracked files in the broader config directories
UNTRACKED=$(git ls-files --others --exclude-standard config/ nix/ hosts/ scripts/ lib/ 2>/dev/null)
if [[ -n "$UNTRACKED" ]]; then
  warn "Untracked files exist (may need 'git add'):"
  echo "$UNTRACKED" | sed 's/^/    /'
else
  pass "All config files are git-tracked"
fi

# ── Summary ────────────────────────────────────────────────────────────────
echo ""
echo "─────────────────────────────────────────────"
if [[ $ERRORS -eq 0 && $WARNINGS -eq 0 ]]; then
  echo -e "${GREEN}All checks passed!${NC} Safe to commit and rebuild."
elif [[ $ERRORS -eq 0 ]]; then
  echo -e "${YELLOW}Passed with $WARNINGS warning(s).${NC} Review warnings before proceeding."
else
  echo -e "${RED}$ERRORS error(s), $WARNINGS warning(s).${NC} Fix errors before committing."
  exit 1
fi
echo ""