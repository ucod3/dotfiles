#!/usr/bin/env bash
#
# Validation script - run before every commit and rebuild
# Catches errors BEFORE they reach the system
#
# Checks:
#   1. Zsh syntax     - all .zsh modules
#   2. Bash syntax    - scripts via bash -n
#   3. Shell linting  - shellcheck for semantic issues
#   4. Nix syntax     - flake.nix, home.nix, configuration.nix
#   5. Nix flake      - full flake check
#   6. Unit tests     - bats test suite for regression coverage
#   7. Common mistakes - hardcoded emails, vim.loop, broken paths
#
# Usage:
#   ./scripts/bin/validate          # run all checks
#   ./scripts/bin/validate --quick  # skip slow nix checks
#

set -euo pipefail

# Declare counters BEFORE sourcing lib/log.sh (which uses them)
ERRORS=0
WARNINGS=0

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
DOTFILES_ROOT="$(dotfiles_root)"
cd "$DOTFILES_ROOT"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"

QUICK_MODE=false

[[ "${1:-}" == "--quick" ]] && QUICK_MODE=true

# ── 1. Zsh syntax ──────────────────────────────────────────────────────────
section "Zsh syntax"
for f in config/zsh/modules/*.zsh config/zsh/custom.zsh config/zsh/.zshenv; do
  if [[ -f "$f" ]]; then
    if zsh -n "$f" 2>/dev/null; then
      pass "$f"
    else
      fail "$f — syntax error:"
      zsh -n "$f" 2>&1 | sed 's/^/    /'
    fi
  fi
done

# ── 2. Shell script syntax ─────────────────────────────────────────────────
# Derived from git, not hand-listed. Two hand-maintained lists (here and in
# .github/workflows/ci.yml) had drifted apart, leaving three scripts checked by
# neither.
SH_SCRIPTS=()
while IFS= read -r _f; do
  [[ -f "$_f" ]] || continue
  head -1 "$_f" | grep -q 'bash' && SH_SCRIPTS+=("$_f")
done < <(git ls-files 'scripts/bin/*' 'lib/*.sh' 'install.sh' 2>/dev/null)

section "Shell script syntax"
for f in ${SH_SCRIPTS[@]+"${SH_SCRIPTS[@]}"}; do
  if [[ -f "$f" ]]; then
    if bash -n "$f" 2>/dev/null; then
      pass "$f"
    else
      fail "$f — syntax error:"
      bash -n "$f" 2>&1 | sed 's/^/    /'
    fi
  fi
done

# ── 3. Shell script linting (shellcheck) ────────────────────────────────────
section "Shell script linting"
if command -v shellcheck >/dev/null 2>&1; then
  for f in ${SH_SCRIPTS[@]+"${SH_SCRIPTS[@]}"}; do
    if [[ -f "$f" ]]; then
      # Run shellcheck with specific exclusions for this codebase
      # SC1090: Can't follow non-constant source (we use dynamic paths)
      # SC1091: Not following sourced file (we check syntax separately)
      if shellcheck --shell=bash --severity=warning --exclude=SC1090,SC1091 "$f" 2>/dev/null; then
        pass "$f"
      else
        warn "$f — shellcheck issues found (see above)"
      fi
    fi
  done
else
  pass "shellcheck not installed — skipping (install with: nix-env -iA nixpkgs.shellcheck)"
fi

# ── 4. Nix syntax ──────────────────────────────────────────────────────────
if [[ "$QUICK_MODE" == false ]]; then
  section "Nix syntax"
  # Every tracked .nix file, not just the three entry points — 9 of 13 were
  # previously unchecked, and hosts/_template.nix was checked by nothing.
  for f in $(git ls-files '*.nix'); do
    if [[ -f "$f" ]]; then
      if nix-instantiate --parse "$f" > /dev/null 2>&1; then
        pass "$f"
      else
        fail "$f — syntax error:"
        nix-instantiate --parse "$f" 2>&1 | sed 's/^/    /'
      fi
    fi
  done
fi

# ── 5. Nix flake check ─────────────────────────────────────────────────────
if [[ "$QUICK_MODE" == false ]]; then
  section "Nix flake check"
  # HARD failure — deliberately not a warning.
  #
  # flake.nix exports evaluation checks (cold + full) that instantiate
  # hosts/default.nix and nix/home/home.nix against a dummy host identity.
  # They exist because `darwinConfigurations` is empty here, which used to
  # make `nix flake check` a no-op that validated nothing (audit finding H2).
  # Downgrading this back to a warning would make those checks advisory and
  # let a broken module ship green — the exact gap they were added to close.
  #
  # Errors are surfaced rather than sent to /dev/null: a silent "had issues"
  # tells the operator nothing actionable.
  flake_log="$(mktemp -t dotfiles-flake-check.XXXXXX)"
  if nix flake check > "$flake_log" 2>&1; then
    pass "flake.nix evaluates (cold + full host checks)"
  else
    fail "nix flake check failed — a module does not evaluate:"
    tail -n 30 "$flake_log" | sed 's/^/    /'
  fi
  rm -f "$flake_log"
fi

# ── 6. Unit tests (bats) ────────────────────────────────────────────────────
section "Unit tests"
if [[ -d "tests" ]]; then
  if command -v bats >/dev/null 2>&1; then
    # HARD failure — deliberately not a warning.
    #
    # This used to `warn`, so a red test suite still exited 0. Everything built
    # on top of validate inherited that: the fail-closed pre-commit hook let the
    # commit through, `dot update`'s pre-flight proceeded, and `dot apps`
    # reported "Config is valid" against broken behaviour. The suite covers the
    # adoption guards that move real files out of $HOME — advisory is the wrong
    # severity for those.
    #
    # stderr is no longer discarded: `2>/dev/null` hid the very output the old
    # "see output above" message pointed at.
    if bats tests/; then
      pass "All bats tests passed"
    else
      fail "bats tests failed (see output above)"
    fi
  else
    pass "bats not installed — skipping unit tests (install with: nix-env -iA nixpkgs.bats)"
  fi
else
  pass "No tests/ directory found — skipping unit tests"
fi

# ── 7. Common mistakes ─────────────────────────────────────────────────────
section "Common mistakes"

# Check for deprecated vim.loop (should use vim.uv)
if grep -r "vim\.loop\." config/nvim/ 2>/dev/null | grep -v "vim.uv or vim.loop"; then
  fail "Deprecated vim.loop found in nvim config (use vim.uv or (vim.uv or vim.loop))"
else
  pass "No deprecated vim.loop usage"
fi

# Check for hardcoded personal emails in tracked files (customize regex for your domain)
staged_files=$(git diff --cached --name-only 2>/dev/null)
if [[ -n "$staged_files" ]]; then
  if echo "$staged_files" | xargs grep -lE "[a-z]+\.[a-z]+@[a-z]+\.(com|org|net|io)" 2>/dev/null | grep -v "git/config"; then
    warn "Email addresses found in staged files — verify these are intentional"
  else
    pass "No email addresses in staged files"
  fi
else
  pass "No staged files to check"
fi

# Check for double-quoted $HOME in aliases (expands at source time, not run time)
if grep -n 'alias.*=".*\$HOME' config/zsh/modules/aliases.zsh 2>/dev/null; then
  warn "Double-quoted \$HOME in aliases — these expand at source time. Use single quotes."
else
  pass "Alias quoting is correct"
fi

# Check module paths reference DOTFILES_ROOT not hardcoded paths
if grep -n "/Users/[a-z]" config/zsh/modules/*.zsh config/zsh/custom.zsh 2>/dev/null | grep -v "DOTFILES_ROOT\|HOME"; then
  fail "Hardcoded /Users/ path found in zsh modules — use DOTFILES_ROOT instead"
else
  pass "No hardcoded home paths in zsh modules"
fi

# Check that modules directory path in custom.zsh is dynamic
if grep -q 'DOTFILES_ROOT\|HOME.*dotfiles' config/zsh/custom.zsh 2>/dev/null; then
  pass "Module path in custom.zsh is dynamic"
else
  fail "custom.zsh may have hardcoded module path"
fi

# Portability: rebuild must use dynamic hostname, not a hardcoded flake attribute
if grep -qE 'darwin-rebuild.*#(m4pro|Usmans-M4Pro|My-MacBook|HardcodedHost)' scripts/bin/rebuild 2>/dev/null; then
  fail "rebuild script has a hardcoded hostname — it must use \"\${HOSTNAME}\" dynamically"
else
  pass "rebuild uses dynamic hostname resolution"
fi

# Purity: getEnv in Nix files defeats flake reproducibility.
# Sole sanctioned exception: lib/local.nix (ADR-004) — the impure-aware
# loader for the gitignored .local settings layer, which degrades to empty
# settings under pure evaluation.
GETENV_STRAY=$(git ls-files '*.nix' | xargs grep -n 'builtins\.getEnv' 2>/dev/null \
  | grep -v '^lib/local\.nix:' || true)
if [[ -n "$GETENV_STRAY" ]]; then
  fail "builtins.getEnv found outside lib/local.nix — this breaks pure evaluation (ADR-004):"
  echo "$GETENV_STRAY" | sed 's/^/    /'
else
  pass "No builtins.getEnv outside the sanctioned lib/local.nix loader"
fi

# ...and the converse. If the loader ever loses its getEnv the .local/ layer
# silently stops resolving and every opt-in quietly reverts to its default —
# which looks like a clean pass rather than a failure.
if grep -q 'builtins\.getEnv' lib/local.nix 2>/dev/null; then
  pass "lib/local.nix retains its sanctioned impure read"
else
  fail "lib/local.nix has no builtins.getEnv — the .local/ settings loader is broken (ADR-004)"
fi

# Portability: flake.nix must delegate to mkHost, not hard-wire a hostname
if grep -q '"m4pro"' flake.nix 2>/dev/null; then
  fail "Stale hardcoded 'm4pro' attribute found in flake.nix"
else
  pass "flake.nix uses dynamic host matrix"
fi

# Check for untracked config files that Nix references
section "Git tracking"
NIX_SOURCES=$(grep -h "source = \.\." nix/home/home.nix hosts/default.nix 2>/dev/null \
  | sed 's/.*source = \.\.\/\.\.\///;s/[";].*//;s/ //g' | sort -u)
while IFS= read -r src; do
  # --error-unmatch echoes matched paths on success; silence stdout so the
  # section shows only real failures.
  if [[ -n "$src" ]] && ! git ls-files --error-unmatch "$src" >/dev/null 2>&1; then
    fail "Nix references '$src' but it's not tracked by git (run: git add $src)"
  fi
done <<< "$NIX_SOURCES"

# Agent adapter directories must be tracked — an untracked rule or skill
# silently fails to apply on any other machine. Vendor-neutral: each path is
# checked only if it exists, so this works for whichever tools a fork uses.
AGENT_DIRS=(.devin/rules .devin/skills .devin/workflows .claude .cursor/rules .github)
UNTRACKED_AGENT=""
for d in "${AGENT_DIRS[@]}"; do
  [[ -d "$d" ]] || continue
  found=$(git ls-files --others --exclude-standard "$d" 2>/dev/null)
  [[ -n "$found" ]] && UNTRACKED_AGENT+="$found"$'\n'
done
if [[ -n "${UNTRACKED_AGENT// /}" ]]; then
  fail "Untracked agent config — rules/skills won't apply elsewhere (run: git add):"
  echo "$UNTRACKED_AGENT" | sed '/^$/d;s/^/    /'
else
  pass "Agent configuration is git-tracked"
fi

# Check for any untracked files in the broader config directories
UNTRACKED=$(git ls-files --others --exclude-standard config/ nix/ hosts/ scripts/ lib/ 2>/dev/null)
if [[ -n "$UNTRACKED" ]]; then
  warn "Untracked files exist (may need 'git add'):"
  echo "$UNTRACKED" | sed 's/^/    /'
else
  pass "All config files are git-tracked"
fi

# ── Summary ────────────────────────────────────────────────────────────────
echo ""
echo "─────────────────────────────────────────────"
if [[ $ERRORS -eq 0 && $WARNINGS -eq 0 ]]; then
  echo -e "${GREEN}All checks passed!${NC} Safe to commit and rebuild."
elif [[ $ERRORS -eq 0 ]]; then
  echo -e "${YELLOW}Passed with $WARNINGS warning(s).${NC} Review warnings before proceeding."
else
  echo -e "${RED}$ERRORS error(s), $WARNINGS warning(s).${NC} Fix errors before committing."
  exit 1
fi
echo ""