#!/usr/bin/env bash
#
# Install git hooks for this repo
# Called automatically by rebuild and install.sh
# Safe to run multiple times (idempotent)
#
# Usage:
#   ./scripts/bin/install-hooks           # verbose
#   ./scripts/bin/install-hooks --quiet   # silent unless error
#

DOTFILES_ROOT="${DOTFILES_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$HOME/dotfiles")}"
HOOKS_DIR="$DOTFILES_ROOT/.git/hooks"
QUIET=false

[[ "${1:-}" == "--quiet" ]] && QUIET=true

# Nothing to do if not a git repo
if [[ ! -d "$HOOKS_DIR" ]]; then
  [[ "$QUIET" == false ]] && echo "Warning: .git/hooks not found, skipping hook installation"
  exit 0
fi

# Write the composite pre-commit hook (validate + gitleaks)
cat > "$HOOKS_DIR/pre-commit" << 'EOF'
#!/usr/bin/env bash
# Pre-commit hook: syntax validation + secret scanning
# Installed automatically by rebuild and install.sh
# To bypass once: git commit --no-verify
set -euo pipefail

DOTFILES_ROOT="$(git rev-parse --show-toplevel)"

# ── 1. Syntax & common-mistake validation ──────────────────────────────────
"$DOTFILES_ROOT/scripts/bin/validate" --quick

# ── 2. Secret scanning (mandatory — fail closed) ────────────────────────────
# gitleaks ships via nix-darwin, but this hook is installed on a fresh clone
# before that build has run. Fall back to `nix run` so the very first commit is
# still scanned rather than blocked.
GITLEAKS=()
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS=( gitleaks )
elif command -v nix >/dev/null 2>&1; then
  echo "  gitleaks not on PATH — running via nix (first run downloads it)..."
  GITLEAKS=( nix --extra-experimental-features "nix-command flakes" run nixpkgs#gitleaks -- )
elif command -v brew >/dev/null 2>&1; then
  echo "  gitleaks not installed — attempting auto-install via Homebrew..."
  brew install gitleaks >/dev/null 2>&1 && GITLEAKS=( gitleaks )
fi

if [[ ${#GITLEAKS[@]} -eq 0 ]]; then
  echo "✗ gitleaks is required for secret scanning but could not be obtained." >&2
  echo "  Install Nix, or run: brew install gitleaks" >&2
  echo "  (Refusing to commit without a secret scan. Emergency bypass: git commit --no-verify)" >&2
  exit 1
fi

"${GITLEAKS[@]}" detect \
  --source "$DOTFILES_ROOT" \
  --config "$DOTFILES_ROOT/.gitleaks.toml" \
  --redact \
  --no-git
EOF

chmod +x "$HOOKS_DIR/pre-commit"

if [[ "$QUIET" == false ]]; then
  echo "✓ Git pre-commit hook installed (validate + gitleaks, fail-closed)"
  echo "  Runs syntax checks and mandatory secret scanning on every commit"
  echo "  Emergency bypass only: git commit --no-verify"
fi