#!/usr/bin/env bash
#
# dot-adopt — turn unmanaged $HOME files into declarative Home Manager mappings
#
# Two subcommands, both dispatched from `dot`:
#
#   dot scan-unmapped          List adoption candidates under $HOME and ~/.config
#   dot adopt <path>           Move a path into ~/dotfiles-private and declare it
#
# Adoption moves the real file into ~/dotfiles-private/home/<rel>, appends a
# `home.file."<rel>".source = ./home/<rel>;` mapping to ~/dotfiles-private/home.nix,
# and stages both in that repo. After `dot rebuild`, ~/<rel> becomes a symlink
# into /nix/store — read-only by design. Edit the copy in dotfiles-private and
# rebuild; do not edit the symlink target.
#
# Why the mapping uses a path literal (./home/<rel>) rather than an interpolated
# string: a path literal is copied into the store as part of the flake source,
# so it evaluates purely and reproduces on another machine. An absolute-path
# string would make Home Manager call builtins.path on a context-free string —
# an impure read that only resolves under --impure and is invisible to git.
#
# Why staging is mandatory: ~/dotfiles-private is consumed via `git+file://`.
# The evaluator reads the working tree but EXCLUDES untracked files, so an
# unstaged adoption is silently invisible and fails in confusing ways (R2).
#
# Usage:
#   dot scan-unmapped
#   dot adopt ~/.claude/CLAUDE.md
#   dot adopt ~/.config/neofetch --dry-run
#   dot adopt ~/.config/zed/settings.json --mutable
#
# --mutable deploys the path as a symlink to the real file in the private repo
# instead of to a read-only /nix/store copy. Use it whenever the application
# rewrites the file itself — editor and CLI `settings.json` files are the usual
# case. Without it those apps hit a read-only file and silently fail to save.
# The file is versioned either way; only writability differs.
#

set -euo pipefail

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
DOTFILES_ROOT="$(dotfiles_root)"
PRIVATE_ROOT="$(private_flake_root)"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
# The home.nix stub and its insertion sentinel are shared with
# scripts/bin/setup-private-host, which now creates the file up front so the
# generated host module can import it unconditionally.
# shellcheck source=../../lib/private-flake.sh
source "$DOTFILES_ROOT/lib/private-flake.sh"

ADOPT_SUBDIR="$DOT_ADOPT_SUBDIR"
ADOPT_DIR="$PRIVATE_ROOT/$ADOPT_SUBDIR"
HOME_NIX="$PRIVATE_ROOT/home.nix"

SENTINEL="$DOT_ADOPT_SENTINEL"

# $HOME with symlinks resolved, so prefix comparisons are reliable.
HOME_PHYS="$(cd "$HOME" && pwd -P)"

# ── Path classification data ──────────────────────────────────────────────────

# Never adoptable: credential material. Committing these to a git repo — even a
# private one — writes them into history permanently. Refused outright rather
# than warned about, since a warning is easy to click past.
SECRET_PATHS=(
  ".ssh" ".gnupg" ".aws" ".netrc" ".docker"
  ".config/gh" ".config/github-copilot" ".config/op"
  ".claude.json" ".codeium" ".supermaven" ".antigravity"
)

# Machine-local churn: caches, histories, compiled artefacts, trash. Nothing
# here is worth version control, and several are rewritten continuously.
# Entries are glob patterns, matched against the whole path or any parent of it.
NOISE_PATHS=(
  ".cache" ".Trash" ".DS_Store" ".CFUserTextEncoding" ".viminfo"
  ".npm" ".pnpm-state" ".nix-defexpr" ".nix-profile" ".nix-channels"
  ".local" ".oh-my-zsh" ".zsh_sessions" ".zsh_history"
  ".Xauthority" ".lesshst" ".node_repl_history" ".python_history"
  ".config/Code - Insiders" ".config/nvim.pre-home-manager"
  # Compiled zsh completion caches. Machine- and version-suffixed, rewritten
  # on almost every shell start, and meaningless on another host.
  ".zcompdump*"
)

# ── Helpers ───────────────────────────────────────────────────────────────────

die() {
  log_error "$1"
  exit 1
}

# Fully resolve a symlink chain. Prints the final target, or the input itself
# when it is not a symlink. Bounded so a cyclic link cannot hang the script.
resolve_link() {
  local p="$1" hops=0 target
  while [[ -L "$p" ]]; do
    hops=$(( hops + 1 ))
    if (( hops > 40 )); then
      printf '%s\n' "$p"
      return 1
    fi
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$(dirname "$p")/$target" ;;
    esac
  done
  printf '%s\n' "$p"
}

# Absolute path with the parent resolved physically, but the final component
# left untouched — we must be able to see that the target itself is a symlink.
to_abs() {
  local p="$1" parent base
  [[ "$p" == /* ]] || p="$PWD/$p"
  p="${p%/}"
  [[ -n "$p" ]] || p="/"
  parent="$(dirname "$p")"
  base="$(basename "$p")"
  parent="$(cd "$parent" 2>/dev/null && pwd -P)" || return 1
  printf '%s\n' "${parent%/}/$base"
}

is_store_symlink() {
  local p="$1" target
  [[ -L "$p" ]] || return 1
  target="$(resolve_link "$p")"
  [[ "$target" == /nix/store/* ]]
}

is_adopted_symlink() {
  local p="$1" target
  [[ -L "$p" ]] || return 1
  target="$(resolve_link "$p")"
  [[ "$target" == "$PRIVATE_ROOT"/* ]]
}

# Count symlinks into /nix/store beneath a directory. A non-zero count means
# Home Manager already owns files inside it, so adopting the directory would
# move store symlinks into the private repo and give those paths two owners.
# $2 caps the search depth: scanning uses a shallow probe for speed, adoption
# uses an unbounded one because a missed link there corrupts HM state.
count_store_links() {
  local dir="$1" maxdepth="${2:-}" link target count=0
  local -a find_args=("$dir")
  [[ -n "$maxdepth" ]] && find_args+=(-maxdepth "$maxdepth")
  find_args+=(-type l)
  while IFS= read -r link; do
    target="$(resolve_link "$link")"
    [[ "$target" == /nix/store/* ]] && count=$(( count + 1 ))
  done < <(find "${find_args[@]}" 2>/dev/null)
  printf '%s\n' "$count"
}

# Match a path against a list of glob patterns, treating a match on any parent
# as a match (".ssh" also covers ".ssh/config").
list_match() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    # shellcheck disable=SC2254  # unquoted on purpose: list entries are globs
    case "$needle" in
      $item|$item/*) return 0 ;;
    esac
  done
  return 1
}

# Home Manager attribute names are quoted strings; a path containing a quote or
# backslash would break out of the generated Nix. Refuse rather than escape —
# no legitimate dotfile needs those characters.
# A path is adoptable when it can be embedded in a double-quoted Nix string and
# in a shell argument without either changing meaning.
#
# Spaces ARE allowed. The original character class excluded them, which quietly
# made every macOS application config unadoptable — they all live under
# `~/Library/Application Support/`, so `dot adopt` could not touch a single
# editor, terminal or app preference file on the platform it targets.
#
# What must stay excluded is anything that escapes the quoting:
#   "  \  ${   end the Nix string or start an interpolation
#   newline / tab   survive into the generated Nix as a line break
#   ..              path traversal out of $HOME
valid_rel() {
  local rel="$1"
  [[ -n "$rel" ]] || return 1
  [[ "$rel" == *'"'*   ]] && return 1
  [[ "$rel" == *'\'*   ]] && return 1
  [[ "$rel" == *'${'*  ]] && return 1
  [[ "$rel" == *'`'*   ]] && return 1
  [[ "$rel" == *".."*  ]] && return 1
  [[ "$rel" == -*      ]] && return 1  # would be read as an option
  [[ "$rel" == */      ]] && return 1
  # Control characters, including newline and tab.
  [[ "$rel" == *[[:cntrl:]]* ]] && return 1
  return 0
}

require_private_repo() {
  [[ -d "$PRIVATE_ROOT" ]] \
    || die "Private flake not found at $PRIVATE_ROOT (set DOTFILES_PRIVATE_FLAKE to override)"
  git -C "$PRIVATE_ROOT" rev-parse --git-dir >/dev/null 2>&1 \
    || die "$PRIVATE_ROOT is not a git repository — adoption requires it (R2)"
}

# ── Is the repo holding the adopted files backed up anywhere? ─────────────────
#
# Adoption moves files into $PRIVATE_ROOT and stages them. That is the whole of
# what "backed up" meant here — a git repository on the same disk as the files
# it protects. The scan then reported "Nothing would be lost", having never
# asked whether that repository exists anywhere else. On the machine this was
# found on, it was 14 commits ahead of a remote that had never received them.
#
# Prints zero or more `REASON|DETAIL` lines; empty output means genuinely safe.
# Every git call is guarded: this runs under `set -euo pipefail`, and a repo
# with no commits or no upstream makes rev-list and rev-parse fail.
private_backup_risks() {
  local branch upstream ahead dirty

  if [[ ! -d "$PRIVATE_ROOT" ]] \
     || ! git -C "$PRIVATE_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'NOREPO|\n'
    return 0
  fi

  if ! git -C "$PRIVATE_ROOT" remote get-url origin >/dev/null 2>&1; then
    printf 'NOREMOTE|\n'
  else
    branch="$(git -C "$PRIVATE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    upstream="$(git -C "$PRIVATE_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    if [[ -z "$upstream" ]]; then
      printf 'NOUPSTREAM|%s\n' "${branch:-HEAD}"
    else
      ahead="$(git -C "$PRIVATE_ROOT" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
      [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
      (( ahead > 0 )) && printf 'AHEAD|%s %s\n' "$ahead" "${branch:-HEAD}"
    fi
  fi

  # Counted, never echoed: `git status --porcelain` output contains real path
  # names, and this block prints after the "would be LOST" marker the tests
  # slice on.
  dirty="$(git -C "$PRIVATE_ROOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ "$dirty" =~ ^[0-9]+$ ]] || dirty=0
  (( dirty > 0 )) && printf 'DIRTY|%s\n' "$dirty"

  return 0
}

# The AT RISK half of the verdict. Prints nothing when there is nothing wrong.
report_backup_risks() {
  local -a risks=()
  local line reason detail out

  # Captured with its status CHECKED, not read from `< <(private_backup_risks)`:
  # a process substitution discards the exit status, so a crash inside the check
  # would arrive here as an empty risk list — indistinguishable from "everything
  # is fine" — and the caller would print the very reassurance this function
  # exists to withhold. That is the bug this whole file was rewritten to kill,
  # re-entering through the back door. Fail closed.
  out="$(private_backup_risks)" || out='UNKNOWN|'

  while IFS= read -r line; do
    [[ -n "$line" ]] && risks+=("$line")
  done <<< "$out"

  (( ${#risks[@]} == 0 )) && return 1

  # Not "is not published": a repo can be fully pushed and still hold
  # uncommitted adoptions. The heading has to be true in every branch below.
  warn "AT RISK — the repo holding your adopted files is not fully protected:"
  printf '\n'
  for line in "${risks[@]}"; do
    reason="${line%%|*}"
    detail="${line#*|}"
    case "$reason" in
      UNKNOWN)
        printf '      The backup check itself could not run — assume UNPROTECTED.\n'
        printf '      Inspect it by hand:  git -C %s status -sb\n' "$PRIVATE_ROOT"
        ;;
      NOREPO)
        printf '      %s is not a git repository — backed up to NOWHERE.\n' "$PRIVATE_ROOT"
        printf '      Create it with:  %s/scripts/bin/setup-private-host\n' "$DOTFILES_ROOT"
        ;;
      NOREMOTE)
        printf '      No remote configured — backed up to NOWHERE.\n'
        printf '      Create a PRIVATE repo on GitHub, then:\n'
        printf '        git -C %s remote add origin git@github.com:<you>/dotfiles-private.git\n' "$PRIVATE_ROOT"
        ;;
      NOUPSTREAM)
        printf '      Branch %s has never been pushed.\n' "${detail}"
        printf '        git -C %s push -u origin %s\n' "$PRIVATE_ROOT" "${detail}"
        ;;
      AHEAD)
        printf '      %s commit(s) exist only on this Mac.\n' "${detail%% *}"
        printf '        dot promote          # publishes it, or:\n'
        printf '        git -C %s push -u origin %s\n' "$PRIVATE_ROOT" "${detail##* }"
        ;;
      DIRTY)
        printf '      %s uncommitted change(s) — adopted files are not yet committed.\n' "$detail"
        printf '        git -C %s add -A && git -C %s commit -m "adopt config"\n' \
          "$PRIVATE_ROOT" "$PRIVATE_ROOT"
        ;;
    esac
  done
  printf '\n'
  return 0
}

# ── scan-unmapped ─────────────────────────────────────────────────────────────

# Look INSIDE a directory before offering it for adoption. Prints "STATUS|NOTE"
# when it should never be offered, and nothing when it looks like real config.
#
# WHY THIS EXISTS
#   Classification used to be the SECRET_PATHS / NOISE_PATHS name lists and
#   nothing else, so anything an author had not thought to name was reported as
#   "available to adopt". On a real machine that meant offering ~/.gemini —
#   which holds oauth_creds.json and google_accounts.json — alongside
#   ~/.vscode-insiders, ~/.cursor, ~/.devin and ~/.windsurf, together roughly
#   3 GB of reinstallable editor extensions. Adopting any of them would have
#   put credentials or binaries into git.
#
#   These signals are heuristics and will sometimes be wrong in both
#   directions. That is exactly why every verdict carries a reason and is
#   printed: a silent skip is how the previous version misled people. A human
#   who disagrees can still adopt the path explicitly.
# Credential-shaped CONTENT, regardless of what the file is called.
#
# Filename matching is not enough and this is not hypothetical: on this machine
# ~/.software/extensions.json — an innocuous name, 182 bytes — holds a live
# JWT. A name-only check offered that directory for adoption, i.e. recommended
# committing a working token to git. gitleaks would have caught it at commit
# time, but a tool that RECOMMENDS the leak has already failed.
SECRET_CONTENT_RE='eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|"(access_token|refresh_token|client_secret|api_?key)"[[:space:]]*:[[:space:]]*"[^"]{8,}'

# Prints the offending file when one of the patterns matches a small text file
# at or just below `$1`. Bounded to files under 64 KB and a shallow depth so
# this stays cheap enough to run on every scan.
secret_content_hit() {
  local root="$1"
  find "$root" -maxdepth 2 -type f -size -64k 2>/dev/null \
    | head -200 \
    | while IFS= read -r f; do
        if LC_ALL=C grep -qE "$SECRET_CONTENT_RE" "$f" 2>/dev/null; then
          printf '%s\n' "$f"
          return 0
        fi
      done
}

content_verdict() {
  local abs="$1" hits count

  # A lone file can carry a credential just as easily as a directory can.
  if [[ -f "$abs" && ! -L "$abs" ]]; then
    if [[ "$(stat -f%z "$abs" 2>/dev/null || echo 0)" -lt 65536 ]] \
       && LC_ALL=C grep -qE "$SECRET_CONTENT_RE" "$abs" 2>/dev/null; then
      printf 'SECRET|contains credential-shaped content\n'
    fi
    return
  fi

  [[ -d "$abs" && ! -L "$abs" ]] || return 0

  # 0. Nothing in it. Reporting an empty directory as something you would
  #    "lose" is noise — four of the five editor `snippets/` directories on
  #    this machine are empty.
  if [[ -z "$(find "$abs" -type f -print -quit 2>/dev/null)" ]]; then
    printf 'EMPTY|no files in it\n'
    return
  fi

  # 1. Credential material anywhere near the top. Cheap and the highest stakes:
  #    a leaked token cannot be un-pushed.
  hits="$(find "$abs" -maxdepth 2 \( \
      -iname '*cred*' -o -iname '*oauth*' -o -iname '*token*' -o -iname '*secret*' \
      -o -iname '*.pem' -o -iname '*.key' -o -iname 'id_rsa*' -o -iname 'id_ed25519*' \
    \) -print -quit 2>/dev/null || true)"
  if [[ -n "$hits" ]]; then
    printf 'SECRET|contains %s\n' "$(basename "$hits")"
    return
  fi

  # 1b. …and the same check by content, for credentials in blandly named files.
  hits="$(secret_content_hit "$abs")"
  if [[ -n "$hits" ]]; then
    printf 'SECRET|credential-shaped content in %s\n' "$(basename "$hits")"
    return
  fi

  # 2. Installed payload. An `extensions/` or cache child is the giveaway for
  #    every VS Code fork, and it is reinstallable by definition.
  hits="$(find "$abs" -maxdepth 1 -type d \( \
      -iname 'extensions' -o -iname 'cache' -o -iname 'cached*' -o -iname 'logs' \
    \) -print -quit 2>/dev/null || true)"
  if [[ -n "$hits" ]]; then
    printf 'PAYLOAD|reinstallable (%s/) — not config\n' "$(basename "$hits")"
    return
  fi

  # 3. Too many files to be hand-written configuration. `head` short-circuits,
  #    so this does not walk a 2 GB tree to find that out.
  count="$(find "$abs" -type f 2>/dev/null | head -501 | wc -l | tr -d ' ')"
  if (( count > 500 )); then
    printf 'PAYLOAD|%s+ files — app data, not config\n' "500"
    return
  fi

  return 0
}

# Classify one home-relative path. Prints "STATUS|NOTE".
classify() {
  local abs="$1" rel="$2" links verdict

  if list_match "$rel" "${SECRET_PATHS[@]}"; then
    printf 'SECRET|credential material — never adopt\n'
    return
  fi
  if list_match "$rel" "${NOISE_PATHS[@]}"; then
    printf 'NOISE|machine-local churn\n'
    return
  fi
  if [[ "$abs" == "$DOTFILES_ROOT" || "$abs" == "$DOTFILES_ROOT"/* \
     || "$abs" == "$PRIVATE_ROOT" || "$abs" == "$PRIVATE_ROOT"/* ]]; then
    printf 'REPO|already a dotfiles repository\n'
    return
  fi
  if is_store_symlink "$abs"; then
    printf 'MANAGED|symlink into /nix/store\n'
    return
  fi
  if is_adopted_symlink "$abs"; then
    printf 'ADOPTED|symlink into dotfiles-private\n'
    return
  fi
  if [[ -e "$ADOPT_DIR/$rel" ]]; then
    printf 'PENDING|adopted, awaiting `dot rebuild`\n'
    return
  fi
  if [[ -d "$abs" && ! -L "$abs" ]]; then
    links="$(count_store_links "$abs" 3)"
    if [[ "$links" != "0" ]]; then
      printf 'PARTIAL|%s managed file(s) inside — adopt individually\n' "$links"
      return
    fi
    # Only now look at what is actually inside. Doing this last keeps the
    # cheap name and symlink checks in front of any directory walk.
    verdict="$(content_verdict "$abs")"
    if [[ -n "$verdict" ]]; then
      printf '%s\n' "$verdict"
      return
    fi
    printf 'CANDIDATE|directory\n'
    return
  fi

  verdict="$(content_verdict "$abs")"
  if [[ -n "$verdict" ]]; then
    printf '%s\n' "$verdict"
    return
  fi
  printf 'CANDIDATE|file\n'
}

cmd_scan() {
  local -a candidates=() partial=() skipped_why=()
  local skipped=0 managed=0
  local entry abs rel result status note line

  # $HOME: hidden entries only — visible ones are Documents, Desktop, and other
  # user data that has no business in a dotfiles repo.
  # ~/.config: everything, since that directory is entirely configuration.
  while IFS= read -r abs; do
    [[ -e "$abs" || -L "$abs" ]] || continue
    rel="${abs#"$HOME_PHYS"/}"
    result="$(classify "$abs" "$rel")"
    status="${result%%|*}"
    note="${result#*|}"
    case "$status" in
      CANDIDATE) candidates+=("$rel|$note") ;;
      PARTIAL)   partial+=("$rel|$note") ;;
      MANAGED|ADOPTED|PENDING) managed=$(( managed + 1 )) ;;
      # Genuinely nothing there. Not listed and not counted — an empty
      # directory is neither at risk nor a decision anyone needs to review.
      EMPTY) ;;
      *)         skipped=$(( skipped + 1 )); skipped_why+=("$rel|$note") ;;
    esac
  # .config is excluded from the top-level pass and descended into instead —
  # otherwise it always reports as partially managed, which is true but useless.
  done < <(
    find "$HOME_PHYS" -mindepth 1 -maxdepth 1 -name '.*' ! -name '.config' 2>/dev/null
    [[ -d "$HOME_PHYS/.config" ]] \
      && find "$HOME_PHYS/.config" -mindepth 1 -maxdepth 1 2>/dev/null
    # ~/Library/Application Support/<App>/User/ — where macOS GUI applications
    # actually keep their settings.
    #
    # Omitting this made the scan structurally unable to see the configuration
    # most worth keeping: on this machine six editor settings/keybindings files
    # (Cursor, Code - Insiders, Windsurf, Devin, Antigravity) were invisible to
    # every `dot scan-unmapped` ever run, on a framework that targets macOS
    # exclusively.
    #
    # Only the `<App>/User/` convention is walked, not all of Application
    # Support. The rest is binary app state — `Arc/` alone holds dozens of
    # `Storable*.json` session files including StorableAuthState.json.
    [[ -d "$HOME_PHYS/Library/Application Support" ]] \
      && find "$HOME_PHYS/Library/Application Support" -mindepth 3 -maxdepth 3 \
           -path '*/User/*' \
           \( -name 'settings.json' -o -name 'keybindings.json' -o -name 'snippets' \) \
           2>/dev/null
  )

  if (( ${#partial[@]} > 0 )); then
    section "Partially managed — not adoptable as a whole"
    printf '\n'
    for entry in "${partial[@]}"; do
      # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
      printf '  %-40s %s\n' "~/${entry%%|*}" "${entry#*|}"
    done
    printf '\n'
    log_warning "Home Manager already owns files inside these directories."
    log_warning "Adopt the specific unmanaged file instead, never the directory."
  fi

  # Every skip, with its reason. Printed rather than hidden: these heuristics
  # are fallible, and a person who disagrees can adopt the path anyway. The old
  # output collapsed all of this to "N skipped (credentials, caches,
  # repositories)", which told nobody what had been decided on their behalf.
  if (( ${#skipped_why[@]} > 0 )); then
    section "Deliberately skipped"
    printf '\n'
    for entry in "${skipped_why[@]}"; do
      # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
      printf '  %-40s %s\n' "~/${entry%%|*}" "${entry#*|}"
    done
    printf '\n'
    log_info "Disagree? Adopt it explicitly:  dot adopt ~/<path>"
  fi

  # ── The question this command exists to answer ─────────────────────────────
  section "If this Mac died today"
  printf '\n'
  # Counted from the declarations in home.nix, NOT from what is currently in
  # $HOME. Adoption moves the real file out of $HOME until the next rebuild, so
  # a $HOME-based count drops by one for every file you just protected — the
  # exact opposite of the truth.
  local adopted=0
  local -a adopted_paths=()
  if [[ -f "$HOME_NIX" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] && adopted_paths+=("$line")
    # The `home.file.` prefix is optional because both forms are valid and this
    # script advertises the flat one in its own header and in `dot adopt`'s
    # closing hint — a pattern that only matched the nested form silently
    # dropped hand-written entries from both the count and the list.
    done < <(sed -n 's/^[[:space:]]*\(home\.file\.\)\{0,1\}"\([^"]*\)"\.source.*/\2/p' \
      "$HOME_NIX" 2>/dev/null || true)
    adopted="${#adopted_paths[@]}"
  fi
  # Listed, not just counted: every adopted path is at least one level deep, so
  # `ls ~` cannot show them and a bare number is unverifiable. The guard is not
  # decoration — under `set -u`, expanding an empty array aborts on bash 3.2.
  if (( ${#adopted_paths[@]} > 0 )); then
    # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
    pass "$adopted config path(s) adopted into ~/dotfiles-private:"
    for entry in "${adopted_paths[@]}"; do
      printf '      ~/%s\n' "$entry"
    done
  else
    # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
    pass "no config paths adopted into ~/dotfiles-private yet"
  fi
  pass "plus the shell, git, Neovim and terminal config the framework manages"
  log_info "Applications are listed separately by:  dot apps list"
  printf '\n'

  if (( ${#candidates[@]} > 0 )); then
    warn "${#candidates[@]} would be LOST — not backed up anywhere:"
    printf '\n'
    for entry in "${candidates[@]}"; do
      # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
      printf '      ~/%s\n' "${entry%%|*}"
    done
    printf '\n'
    log_info "Back them up with:"
    log_info "  dot adopt \"~/<path>\" --mutable    # if an app rewrites the file"
    log_info "  dot adopt \"~/<path>\"              # for everything else"
    printf '\n'
  fi

  # The verdict. "Nothing would be lost" is reachable only when there is nothing
  # left to adopt AND the repo holding the adoptions exists somewhere else. A
  # reassurance that skips the second half is how this command came to certify a
  # machine whose only copy of everything was the disk it was running on.
  if ! report_backup_risks && (( ${#candidates[@]} == 0 )); then
    pass "Nothing would be lost. Every config found is backed up and published."
  fi
  printf '\n'
  log_warning "Never covered here: SSH keys, app logins, licences."
  log_warning "Those belong in a password manager or Time Machine, not in git."
  echo ""
}

# ── adopt ─────────────────────────────────────────────────────────────────────

# A private flake generated by the current setup-private-host already has this
# file (and already imports it), so this is now the backstop for a hand-written
# or older private repo rather than the normal path.
ensure_home_nix() {
  [[ -f "$HOME_NIX" ]] && return 0
  log_step "Creating $HOME_NIX"
  write_home_nix_stub "$HOME_NIX"
}

# The mapping is inserted above the sentinel rather than appended to the end of
# the file, so the generated Nix stays syntactically valid without parsing it.
append_mapping() {
  local rel="$1" mutable="${2:-false}" tmp

  grep -qF "$SENTINEL" "$HOME_NIX" || die \
    "$HOME_NIX has no dot-adopt sentinel. Add this line inside its home.file block:
    $SENTINEL"

  tmp="$(mktemp -t dot-adopt.XXXXXX)"
  while IFS= read -r line; do
    if [[ "$line" == *"$SENTINEL"* ]]; then
      if [[ "$mutable" == true ]]; then
        # Points at the real file in this repository, not a store copy, so the
        # deployed path stays writable. `${config.home.homeDirectory}` rather
        # than a literal /Users/<name> keeps the entry valid on a second Mac
        # with a different username.
        # shellcheck disable=SC2016  # ${config...} is Nix syntax, must stay literal
        printf '    "%s".source =\n      config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/%s/%s/%s";\n' \
          "$rel" "$(basename "$PRIVATE_ROOT")" "$ADOPT_SUBDIR" "$rel"
      else
        printf '    "%s".source = ./%s/%s;\n' "$rel" "$ADOPT_SUBDIR" "$rel"
      fi
    fi
    printf '%s\n' "$line"
  done < "$HOME_NIX" > "$tmp"
  mv "$tmp" "$HOME_NIX"
}

# home.nix must take `config` for mkOutOfStoreSymlink to resolve. Stubs written
# by an older setup-private-host start `{ ... }:` and would fail to evaluate the
# moment a mutable mapping is added.
ensure_config_arg() {
  grep -q '^{ *config *,' "$HOME_NIX" && return 0
  local tmp
  tmp="$(mktemp -t dot-adopt.XXXXXX)"
  sed 's/^{ \.\.\. }:$/{ config, ... }:/' "$HOME_NIX" > "$tmp"
  grep -q '^{ config, \.\.\. }:$' "$tmp" || {
    rm -f "$tmp"
    die "$HOME_NIX does not start with '{ ... }:' — add \`config\` to its argument
    set by hand before adopting a mutable path."
  }
  mv "$tmp" "$HOME_NIX"
  log_info "Added \`config\` to the $HOME_NIX argument set (needed for --mutable)"
}

# home.nix is inert unless a host module imports it. Silence here would mean a
# successful adoption that never deploys.
warn_if_unwired() {
  local hits
  hits="$(grep -rl 'home\.nix' "$PRIVATE_ROOT" \
    --include='*.nix' --exclude='home.nix' 2>/dev/null || true)"
  [[ -n "$hits" ]] && return 0

  log_warning "No module in $PRIVATE_ROOT imports home.nix — adoptions will NOT deploy."
  log_warning "Add ./home.nix to the Home Manager user module in your host file:"
  echo ""
  echo "    users.\${user}.imports = ["
  echo "      inputs.dotfiles.darwinModules.homeEnvironment"
  echo "      ./home.nix"
  echo "    ];"
  echo ""
}

cmd_adopt() {
  local target="" dry_run=false mutable=false arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=true ;;
      --mutable) mutable=true ;;
      -*)        die "Unknown option: $arg" ;;
      *)
        [[ -n "$target" ]] && die "Adopt takes exactly one path (got '$target' and '$arg')"
        target="$arg"
        ;;
    esac
  done
  [[ -n "$target" ]] || die "Usage: dot adopt <path-in-home> [--mutable] [--dry-run]"

  require_private_repo

  local abs rel dest links adopt_verdict
  abs="$(to_abs "$target")" || die "Cannot resolve path: $target"

  # ── Guards ──
  [[ -e "$abs" || -L "$abs" ]] || die "Path does not exist: $abs"

  [[ "$abs" == "$HOME_PHYS"/* ]] \
    || die "Path is outside \$HOME, so it has no home-relative mapping: $abs"

  rel="${abs#"$HOME_PHYS"/}"

  valid_rel "$rel" \
    || die "Refusing '$rel' — path contains characters that cannot be safely quoted in Nix"

  [[ "$abs" == "$DOTFILES_ROOT"/* || "$abs" == "$PRIVATE_ROOT"/* ]] \
    && die "Path is already inside a dotfiles repository: $abs"

  if list_match "$rel" "${SECRET_PATHS[@]}"; then
    die "Refusing to adopt '$rel' — credential material must never enter git history"
  fi

  # The same content check `scan-unmapped` uses. Without it the two commands
  # disagree: the scan would decline to recommend a path holding a live token
  # while `dot adopt <that path>` still moved it into git without comment.
  # Only SECRET blocks — PAYLOAD and EMPTY are wasteful, not dangerous, and a
  # human asking for them explicitly may have a reason.
  adopt_verdict="$(content_verdict "$abs")"
  if [[ "${adopt_verdict%%|*}" == "SECRET" ]]; then
    die "Refusing to adopt '$rel' — ${adopt_verdict#*|}.
    Credential material must never enter git history. Adopt the specific
    non-secret file inside it instead, if there is one."
  fi

  is_store_symlink "$abs" \
    && die "Already managed: $rel is a symlink into /nix/store"

  is_adopted_symlink "$abs" \
    && die "Already adopted: $rel points into $PRIVATE_ROOT"

  dest="$ADOPT_DIR/$rel"
  [[ -e "$dest" ]] \
    && die "Destination already exists: $dest (adopted previously — run 'dot rebuild')"

  if [[ -f "$HOME_NIX" ]] && grep -qF "\"$rel\".source" "$HOME_NIX"; then
    die "A mapping for '$rel' already exists in $HOME_NIX"
  fi

  # The guard that matters most: adopting a directory Home Manager already
  # writes into would move its store symlinks here and create a second owner.
  if [[ -d "$abs" && ! -L "$abs" ]]; then
    links="$(count_store_links "$abs")"
    if [[ "$links" != "0" ]]; then
      die "Refusing to adopt directory '$rel' — it contains $links Home Manager symlink(s).
    Adopting it would move /nix/store links into the private repo and give those
    paths two owners. Adopt the individual unmanaged files inside it instead."
    fi
  fi

  # ── Report ──
  log_info "Adopting: ~/$rel"
  log_info "  from:   $abs"
  log_info "  to:     $dest"
  if [[ "$mutable" == true ]]; then
    log_info "  map:    mkOutOfStoreSymlink → $dest"
    log_info "  mode:   MUTABLE — the deployed path stays writable, so the app can"
    log_info "          keep saving its own settings straight into $PRIVATE_ROOT."
  else
    log_info "  map:    home.file.\"$rel\".source = ./$ADOPT_SUBDIR/$rel;"
    log_info "  mode:   read-only — deployed as a /nix/store symlink. Use --mutable"
    log_info "          if an application rewrites this file itself."
  fi

  if [[ "$dry_run" == true ]]; then
    echo ""
    log_success "Dry run — nothing was moved or written."
    return 0
  fi

  # ── Mutate ──
  log_step "Moving into $PRIVATE_ROOT"
  mkdir -p "$(dirname "$dest")"
  mv "$abs" "$dest"

  ensure_home_nix
  [[ "$mutable" == true ]] && ensure_config_arg

  # If declaring the mapping fails, put the file back rather than leaving the
  # user with a moved file and no declaration (R7 — no stacking on a broken state).
  if ! append_mapping "$rel" "$mutable"; then
    log_error "Failed to write the mapping — restoring $abs"
    mv "$dest" "$abs"
    exit 1
  fi

  log_step "Staging in $PRIVATE_ROOT (R2 — the evaluator ignores untracked files)"
  git -C "$PRIVATE_ROOT" add -- "$ADOPT_SUBDIR/$rel" "home.nix"

  echo ""
  log_success "Adopted ~/$rel"
  echo ""
  # shellcheck disable=SC2088  # literal "~/" is display text, not a path to expand
  log_info "~/$rel no longer exists on disk — Home Manager recreates it on rebuild."
  log_info "Staged in $PRIVATE_ROOT but NOT committed; review and commit yourself."
  echo ""
  warn_if_unwired
  log_info "Next:  dot rebuild"
  echo ""
}

# ── Entry point ───────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    scan-unmapped) cmd_scan "$@" ;;
    adopt)         cmd_adopt "$@" ;;
    *)             die "dot-adopt: expected 'adopt' or 'scan-unmapped', got '$cmd'" ;;
  esac
}

main "$@"
