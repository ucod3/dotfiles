#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
cd "$DOTFILES_ROOT"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"

# Resolve the flake attribute from the current hostname.
# The flake attribute key must match `hostname -s` exactly.
# If hostname resolution fails, derive fallback from registered hosts in flake.nix
HOSTNAME="$(hostname -s 2>/dev/null || true)"
if [[ -z "$HOSTNAME" ]]; then
  # Derive fallback from available host configurations (never hardcode in generic scripts)
  # This aligns with global_rules.md: "Fallback values must be declared in the host's
  # configuration file, never inline in generic scripts"
  if [[ -f "./hosts/default.nix" ]]; then
    HOSTNAME="default"
  elif [[ -f "./flake.nix" ]]; then
    # Extract first host from darwinConfigurations in flake.nix
    HOSTNAME=$(grep -o '"[^"]*" = mkHost' ./flake.nix | head -1 | sed 's/"\(.*\)" = mkHost/\1/')
  fi

  if [[ -z "$HOSTNAME" ]]; then
    log_error "Could not resolve hostname and no fallback available in hosts/"
    log_error "Please ensure a host config exists in hosts/<hostname>.nix"
    exit 1
  fi

  log_warning "Could not resolve hostname — falling back to '$HOSTNAME' (from flake.nix hosts)"
fi

log_info "Building configuration for host: $HOSTNAME"

# Always ensure git hooks are installed (safe to run multiple times)
if [ -x "$DOTFILES_ROOT/scripts/bin/install-hooks" ]; then
  "$DOTFILES_ROOT/scripts/bin/install-hooks" --quiet
fi

if command -v brew >/dev/null 2>&1; then
  brew update
fi

sudo darwin-rebuild switch --flake ".#${HOSTNAME}"

if [ -x "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers" ]; then
  "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers"
fi