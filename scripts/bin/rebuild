#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
cd "$DOTFILES_ROOT"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"

# Resolve the flake attribute from the current hostname.
# The flake attribute key must match `hostname -s` exactly.
HOSTNAME="$(hostname -s 2>/dev/null || true)"

# Check if the resolved hostname is explicitly defined in flake.nix darwinConfigurations.
# If not, fall back to the generic "default" configuration for clone-and-run compatibility.
if [[ -n "$HOSTNAME" && -f "./flake.nix" ]]; then
  if ! grep -q "\"${HOSTNAME}\" = mkHost" ./flake.nix 2>/dev/null; then
    log_warning "Hostname '${HOSTNAME}' not explicitly mapped in flake.nix darwinConfigurations."
    log_info "Falling back to the generic 'default' system configuration profile."
    HOSTNAME="default"
  fi
elif [[ -z "$HOSTNAME" ]]; then
  log_warning "Could not resolve hostname from system."
  log_info "Falling back to the generic 'default' system configuration profile."
  HOSTNAME="default"
fi

log_info "Building configuration for host: $HOSTNAME"

# Always ensure git hooks are installed (safe to run multiple times)
if [ -x "$DOTFILES_ROOT/scripts/bin/install-hooks" ]; then
  "$DOTFILES_ROOT/scripts/bin/install-hooks" --quiet
fi

if command -v brew >/dev/null 2>&1; then
  brew update
fi

sudo darwin-rebuild switch --flake "${FLAKE_ROOT}#${HOSTNAME}"

if [ -x "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers" ]; then
  "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers"
fi