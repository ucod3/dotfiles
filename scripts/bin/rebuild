#!/usr/bin/env bash
#
# rebuild — switch this Mac to the configuration its flake lock pins.
#
# Usage:
#   rebuild                     # build the locked, pushed revision (default)
#   rebuild --override-local    # build ~/dotfiles as it is on disk, once
#   rebuild --override-local=PATH
#   rebuild --help
#
# The default path is deliberately reproducible: the private flake pins a
# published revision, and nothing in your working tree can reach the live system
# without an explicit flag. See ADR-009.
#
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
cd "$DOTFILES_ROOT"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
# shellcheck source=../../lib/nix.sh
source "$DOTFILES_ROOT/lib/nix.sh"

OVERRIDE_LOCAL=false
OVERRIDE_PATH="$DOTFILES_ROOT"

usage() {
  echo "Usage: rebuild [OPTIONS]"
  echo ""
  echo "Options:"
  echo "      --override-local[=PATH]  Build from a local working tree instead of"
  echo "                               the revision pinned in the private flake"
  echo "                               lock. Staged changes are visible; untracked"
  echo "                               files are not (R2). The lock is NOT written,"
  echo "                               so the next plain rebuild is pinned again."
  echo "  -h, --help                   Show this help message"
  echo ""
  echo "With no options, rebuild is reproducible: it builds exactly the revision"
  echo "named in the private flake's lock. See ADR-009."
}

# An unknown flag must be fatal. A rebuild that silently ignores a typo'd flag
# is the failure mode ADR-009 exists to remove — until this parser existed,
# `dot rebuild --override-local` was accepted and quietly did nothing.
parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      --override-local)
        OVERRIDE_LOCAL=true
        shift
        ;;
      --override-local=*)
        OVERRIDE_LOCAL=true
        OVERRIDE_PATH="${1#*=}"
        shift
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      *)
        log_error "Unknown option: $1"
        echo ""
        usage
        exit 1
        ;;
    esac
  done
}

parse_args "$@"

require_nix

HOSTNAME="$(hostname -s 2>/dev/null || true)"
PRIVATE_FLAKE_ROOT="${DOTFILES_PRIVATE_FLAKE:-$HOME/dotfiles-private}"
FLAKE_ROOT="$DOTFILES_ROOT"

if [[ -z "$HOSTNAME" ]]; then
  log_error "Could not resolve the current hostname."
  exit 1
fi

# Does this flake define a darwinConfiguration for $HOSTNAME? Ask Nix rather
# than grepping for a literal string — a flake that builds its hosts with
# genAttrs or an interpolated name is valid but would never match a text grep.
# Falls back to the grep when evaluation is unavailable (e.g. no network yet).
host_names() {
  local root="$1"
  nix eval --json "${root}#darwinConfigurations" --apply builtins.attrNames 2>/dev/null
}

has_host() {
  local root="$1" names
  names="$(host_names "$root")" || names=""
  if [[ -n "$names" ]]; then
    grep -q "\"${HOSTNAME}\"" <<<"$names"
  else
    grep -q "darwinConfigurations\.\"${HOSTNAME}\"" "$root/flake.nix" 2>/dev/null
  fi
}

if [[ -f "$PRIVATE_FLAKE_ROOT/flake.nix" ]] && has_host "$PRIVATE_FLAKE_ROOT"; then
  FLAKE_ROOT="$PRIVATE_FLAKE_ROOT"
  log_info "Using private host configuration: $FLAKE_ROOT"
elif ! has_host "$DOTFILES_ROOT"; then
  log_error "No configuration found for hostname '$HOSTNAME'."
  if [[ -f "$PRIVATE_FLAKE_ROOT/flake.nix" ]]; then
    available="$(host_names "$PRIVATE_FLAKE_ROOT" || true)"
    [[ -n "$available" ]] && log_info "Hosts defined in $PRIVATE_FLAKE_ROOT: $available"
    log_info "Your hostname may have drifted (macOS renames on some networks)."
    log_info "Add a host with: $DOTFILES_ROOT/scripts/bin/setup-private-host --host '$HOSTNAME'"
  else
    log_info "Create one with: $DOTFILES_ROOT/scripts/bin/setup-private-host"
  fi
  exit 1
fi

log_info "Building configuration for host: $HOSTNAME"

# ── Pin staleness: advisory only ────────────────────────────────────────────
# This block used to run `nix flake update dotfiles` whenever the lock differed
# from `git rev-parse HEAD`. HEAD is whatever branch happens to be checked out,
# so an experimental branch became the live system on the next rebuild, with no
# confirmation. Never mutate the lock here, and never change the exit status:
# a stale pin is a fact to report, not an error. Compare against origin/main —
# the published branch the pin is supposed to track — not HEAD. See ADR-009.
if [[ "$FLAKE_ROOT" != "$DOTFILES_ROOT" ]] && [[ -f "$FLAKE_ROOT/flake.lock" ]]; then
  if command -v git >/dev/null 2>&1 && [[ -d "$DOTFILES_ROOT/.git" ]]; then
    published_rev="$(git -C "$DOTFILES_ROOT" rev-parse origin/main 2>/dev/null || true)"
    locked_dotfiles_rev=""
    if command -v jq >/dev/null 2>&1; then
      locked_dotfiles_rev="$(jq -r '.nodes.dotfiles.locked.rev // empty' "$FLAKE_ROOT/flake.lock" 2>/dev/null || true)"
    fi
    if [[ -z "$locked_dotfiles_rev" ]]; then
      locked_dotfiles_rev="$(grep -A8 '"dotfiles":' "$FLAKE_ROOT/flake.lock" 2>/dev/null | grep '"rev":' | head -n1 | sed -E 's/.*"rev": *"([^"]+)".*/\1/' || true)"
    fi
    if [[ -z "$published_rev" ]]; then
      log_info "No origin/main to compare against; building the pinned revision as-is."
    elif [[ -n "$locked_dotfiles_rev" && "$published_rev" != "$locked_dotfiles_rev" ]]; then
      log_warning "Private flake pins ${locked_dotfiles_rev:0:10}; origin/main is at ${published_rev:0:10}."
      log_info "Not updating automatically. To adopt the published revision:"
      log_info "  cd $FLAKE_ROOT && nix flake update dotfiles && git add flake.lock"
      log_info "(origin/main is a local ref — 'git fetch' first if it looks stale.)"
    fi
  else
    log_warning "Cannot verify private flake pin freshness; ensure $FLAKE_ROOT/flake.lock is deliberate."
  fi
fi

# Always ensure git hooks are installed (safe to run multiple times)
if [ -x "$DOTFILES_ROOT/scripts/bin/install-hooks" ]; then
  "$DOTFILES_ROOT/scripts/bin/install-hooks" --quiet
fi

if command -v brew >/dev/null 2>&1; then
  brew update
fi

# ── Local settings layer (.local/) ──────────────────────────────────────────
# The gitignored .local/ layer is invisible to pure `git+file:` evaluation
# (untracked files are excluded from the store copy), and the `path:` scheme
# is unsafe (copies .git/, hard-fails on the core.fsmonitor socket). The
# verified pattern is an absolute-path read under --impure; lib/local.nix
# resolves $DOTFILES_LOCAL first because sudo may rewrite $HOME.
# Without .local/ the build stays pure-compatible (empty settings), but we
# always pass --impure so selections apply when present.
# Mirror of `settingsFiles` in lib/local.nix — keep the two in sync. A bare
# directory is NOT a settings layer: pointing this at ~/dotfiles-private (which
# setup-private-host creates with no settings files) used to enable destructive
# Homebrew pruning against an empty cask list. See ADR-007.
has_settings_layer() {
  local d="$1"
  [[ -e "$d/settings.nix" || -e "$d/identity.nix" || -e "$d/apps.nix" \
     || -e "$d/browsers/choices.nix" || -e "$d/editors/choices.nix" ]]
}

DOTFILES_LOCAL="${DOTFILES_LOCAL:-$DOTFILES_ROOT/.local}"
if has_settings_layer "$DOTFILES_LOCAL"; then
  log_info "Using local settings layer: $DOTFILES_LOCAL"
else
  log_warning "No .local/ settings layer with content found at $DOTFILES_LOCAL."
  log_warning "Building framework defaults only: nothing opinionated, no Homebrew pruning."
  log_info "Create one by running: $DOTFILES_ROOT/install.sh  (see GETTING-STARTED.md)"
fi

# ── The build ───────────────────────────────────────────────────────────────
# nix-darwin installs `darwin-rebuild`, but the FIRST build is what installs
# nix-darwin — so on a fresh machine the binary does not exist yet. Bootstrap
# that one build through `nix run`. Without this the very first rebuild died
# with a bare "darwin-rebuild: command not found" under `set -e`.
# Paths must be absolute: sudo does not carry the Nix profile on secure_path.
NIX_BIN="$(nix_bin)"
if DR_BIN="$(command -v darwin-rebuild 2>/dev/null)"; then
  REBUILD_CMD=( "$DR_BIN" )
else
  log_warning "darwin-rebuild not found — bootstrapping nix-darwin for the first build."
  log_info "This is expected on a fresh machine; later rebuilds use the installed binary."
  REBUILD_CMD=( "$NIX_BIN" run "github:LnL7/nix-darwin/master#darwin-rebuild" -- )
fi

# ── Opt-in local override ───────────────────────────────────────────────────
# `git+file://` is mandatory here: a bare path selects the `path:` scheme, which
# copies .git/ into the store and hard-fails on the core.fsmonitor socket this
# repo enables (ADR-004). git+file: also gives the R2 semantics already in force
# everywhere else — staged changes are visible, untracked files are not.
# `--no-write-lock-file` keeps the override out of flake.lock, so the next plain
# rebuild returns to the pinned revision with no cleanup.
NIX_FLAGS=()
if [[ "$OVERRIDE_LOCAL" == true ]]; then
  if [[ ! -d "$OVERRIDE_PATH/.git" ]]; then
    log_error "--override-local needs a git repository: $OVERRIDE_PATH is not one."
    exit 1
  fi
  OVERRIDE_ABS="$(cd "$OVERRIDE_PATH" && pwd -P)"
  NIX_FLAGS+=( --override-input dotfiles "git+file://$OVERRIDE_ABS" --no-write-lock-file )
  log_warning "Building from a LOCAL working tree: $OVERRIDE_ABS"
  log_warning "This build is NOT reproducible and the pin is NOT updated."
  log_info "Untracked files stay invisible — 'git add' them first (R2)."
fi

sudo env DOTFILES_LOCAL="$DOTFILES_LOCAL" HOME="$HOME" NIX_CONFIG="$NIX_CONFIG" \
  "${REBUILD_CMD[@]}" switch --flake "${FLAKE_ROOT}#${HOSTNAME}" --impure \
  ${NIX_FLAGS[@]+"${NIX_FLAGS[@]}"}

# Post-flight advisory. It must never invert the exit status of a system
# activation that already succeeded.
if [ -x "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers" ]; then
  "$DOTFILES_ROOT/scripts/bin/check-brew-manual-installers" \
    || log_warning "Post-rebuild cask check reported issues (non-fatal — the rebuild succeeded)."
fi
