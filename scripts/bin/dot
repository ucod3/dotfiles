#!/usr/bin/env bash
#
# dot — unified dotfiles command dispatcher
#
# This is the single entry point for all dotfiles management tasks.
# Every subcommand delegates to the relevant script with zero logic
# duplication — arguments are forwarded verbatim.
#
# Usage:
#   dot <subcommand> [args...]
#
# Subcommands:
#   bootstrap            First-run setup on a fresh Mac (idempotent)
#   rebuild [opts]       Rebuild the system (darwin-rebuild switch)
#   promote [opts]       Publish, move the private flake's pin, and rebuild
#   update  [opts]       Update flake inputs, Homebrew, and rebuild
#   apps    [opts]       Manage installed applications
#   migrate [--preview]  Inspect legacy private-profile migration evidence
#   scan-unmapped        List unmanaged $HOME files available for adoption
#   adopt   <path>       Move a $HOME path into the private flake and declare it
#   validate [--quick]   Run syntax and common-mistake checks
#   secrets [<path>]     Scan for leaked secrets (requires gitleaks)
#   hooks                (Re)install git pre-commit hooks
#   help                 Show this help message
#
# Examples:
#   dot rebuild
#   dot rebuild --override-local
#   dot promote
#   dot update --dry-run
#   dot apps list
#   dot apps add firefox
#   dot scan-unmapped
#   dot adopt ~/.claude/CLAUDE.md
#   dot validate --quick
#   dot secrets
#

set -euo pipefail

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
# Note this dispatcher is also deployed as a /nix/store symlink at
# ~/.local/bin/dot, where the script's own directory is not a checkout — that
# case falls through to $DOTFILES_ROOT / $HOME/dotfiles inside dotfiles_root().
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
DOTFILES_ROOT="$(dotfiles_root)"
# Exported so every subcommand agrees with the dispatcher rather than
# re-deriving a possibly different root.
export DOTFILES_ROOT

BIN="$DOTFILES_ROOT/scripts/bin"

# shellcheck source=../../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"

# ── Subcommand table ──────────────────────────────────────────────────────────
# Maps subcommand name → script path (relative to BIN).
# Arguments after the subcommand are forwarded verbatim via "$@".

dispatch() {
  local cmd="${1:-}"
  shift || true  # consume subcommand; remaining "$@" are its args

  case "$cmd" in

    bootstrap)
      exec "$BIN/bootstrap" "$@"
      ;;

    rebuild)
      exec "$BIN/rebuild" "$@"
      ;;

    promote)
      exec "$BIN/promote" "$@"
      ;;

    update)
      exec "$BIN/update" "$@"
      ;;

    apps)
      exec "$BIN/apps" "$@"
      ;;

    migrate)
      exec "$BIN/migrate-profile" "$@"
      ;;

    # Both adoption subcommands live in one script; the mode is forwarded as
    # its first argument so `dot-adopt` can be run directly too.
    adopt)
      exec "$BIN/dot-adopt" adopt "$@"
      ;;

    scan-unmapped)
      exec "$BIN/dot-adopt" scan-unmapped "$@"
      ;;

    validate)
      exec "$BIN/validate" "$@"
      ;;

    secrets)
      exec "$BIN/scan-secrets" "$@"
      ;;

    hooks)
      exec "$BIN/install-hooks" "$@"
      ;;

    help|--help|-h|"")
      cmd_help
      exit 0
      ;;

    *)
      log_error "Unknown subcommand: '$cmd'"
      echo ""
      cmd_help
      exit 1
      ;;
  esac
}

# ── Help text ─────────────────────────────────────────────────────────────────

cmd_help() {
  echo ""
  echo -e "${BLUE}dot${NC} — dotfiles management"
  echo ""
  echo -e "  ${BLUE}Usage:${NC}  dot <subcommand> [args...]"
  echo ""
  echo -e "  ${BLUE}System${NC}"
  echo "    bootstrap            First-run setup on a fresh Mac (idempotent):"
  echo "                         Nix, conflicting /etc files, private host flake,"
  echo "                         first build, git hooks"
  echo "    rebuild              Rebuild macOS system configuration"
  echo "                         (resolves the private flake first, then this"
  echo "                          repo, for darwinConfigurations.\$(hostname -s))"
  echo "                         Builds the revision the private flake pins —"
  echo "                         your working tree does not reach the live"
  echo "                         system unless you ask for it"
  echo "    rebuild --override-local[=PATH]"
  echo "                         Build a local working tree once, without"
  echo "                         updating the pin. Staged changes only (R2)"
  echo "    promote              Ship what you have built: validate, push,"
  echo "                         move the private flake's pin, commit the lock,"
  echo "                         and rebuild — the one command that makes your"
  echo "                         work actually go live"
  echo "    promote --dry-run    Print the plan without changing anything"
  echo "    promote --no-rebuild Stop after committing the pin"
  echo ""
  echo -e "  ${BLUE}Updates${NC}"
  echo "    update               Update everything and rebuild"
  echo "    update --dry-run     Preview what would be updated"
  echo "    update --auto        Update without prompts (CI-friendly)"
  echo "    update --flake-only  Update flake inputs only, skip rebuild"
  echo ""
  echo -e "  ${BLUE}Apps${NC}"
  echo "    apps                 Show installed app counts"
  echo "    apps list            List all apps by category"
  echo "    apps search <name>   Find the right package name"
  echo "    apps add <name>      Auto-detect and add a Homebrew cask"
  echo "    apps add --cask NAME Add a Homebrew GUI application"
  echo "    apps add --nix ATTR  Add a Nix package as pkgs.ATTR"
  echo "    apps add --mas N ID  Add a Mac App Store application"
  echo "    apps remove <name>   Remove an app from config"
  echo "    apps edit [category] Open the owning private profile file"
  echo ""
  echo -e "  ${BLUE}Adoption${NC}"
  echo "    migrate --preview    Inspect private-profile migration evidence"
  echo "    migrate --preview --applications"
  echo "                         Add application counts and equivalence fingerprints"
  echo "    scan-unmapped        List unmanaged \$HOME and ~/.config paths"
  echo "                         available for adoption"
  echo "    adopt <path>         Move a \$HOME path into ~/dotfiles-private,"
  echo "                         declare it in home.nix, and stage it. After"
  echo "                         'dot rebuild' the path is a read-only symlink"
  echo "                         into /nix/store — edit the private copy instead"
  echo "    adopt <path> --dry-run"
  echo "                         Show what would move, without touching anything"
  echo ""
  echo -e "  ${BLUE}Migration${NC}"
  echo "    migrate              Preview active legacy private-profile sources"
  echo "    migrate --preview    Same read-only inventory; no apply mode exists"
  echo ""
  echo -e "  ${BLUE}Safety${NC}"
  echo "    validate             Full syntax + common-mistake checks"
  echo "    validate --quick     Quick checks only (skip slow Nix eval)"
  echo "    secrets              Scan repository for leaked secrets"
  echo "    secrets <path>       …or any other repo, e.g. ~/dotfiles-private"
  echo "    hooks                (Re)install git pre-commit hooks"
  echo ""
  echo -e "  ${BLUE}Flags${NC}"
  echo "    help, --help, -h     Show this help"
  echo ""
  echo -e "  ${BLUE}Examples${NC}"
  echo "    dot rebuild"
  echo "    dot promote"
  echo "    dot update --dry-run"
  echo "    dot apps add firefox"
  echo "    dot scan-unmapped"
  echo "    dot adopt ~/.claude/CLAUDE.md"
  echo "    dot validate --quick"
  echo ""
}

# ── Entry point ───────────────────────────────────────────────────────────────
dispatch "$@"
