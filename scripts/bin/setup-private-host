#!/usr/bin/env bash
set -euo pipefail

# ── Repo root resolution (see lib/paths.sh) ─────────────────────────────────
_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_PATHS="${_SELF_DIR%/scripts/bin}/lib/paths.sh"
[[ -f "$_PATHS" ]] || _PATHS="${DOTFILES_ROOT:-$HOME/dotfiles}/lib/paths.sh"
# shellcheck source=../../lib/paths.sh
source "$_PATHS"
DOTFILES_ROOT="$(dotfiles_root)"
PRIVATE_ROOT="$(private_flake_root)"
HOSTNAME="$(hostname -s)"
USER_NAME="$(id -un)"
FORK=""

# Flakes are not enabled by the stock Nix installer, and `nix flake lock` below
# is one of the first flake commands a fresh machine ever runs.
# shellcheck source=../../lib/nix.sh
source "$DOTFILES_ROOT/lib/nix.sh"
# Shared private-profile layout detection and adoption stub.
# shellcheck source=../../lib/private-flake.sh
source "$DOTFILES_ROOT/lib/private-flake.sh"

UPSTREAM_REF="github:ucod3/dotfiles"
GENERATOR="$DOTFILES_ROOT/scripts/lib/generate-private-profile.sh"
HOST_TEMPLATE="$DOTFILES_ROOT/templates/private-profile/hosts/host.nix"

usage() {
  cat <<'EOF'
Usage: setup-private-host [--host NAME] [--user NAME] [--fork OWNER/REPO]

Creates ~/dotfiles-private, the private profile containing this Mac's identity,
application choices, preferences, Home Manager configuration, and adopted files.

Ordinary users consume github:ucod3/dotfiles directly. A framework fork is an
advanced override, not an installation requirement.

Options:
  --host NAME        Host to configure (default: hostname -s)
  --user NAME        macOS username (default: id -un)
  --fork OWNER/REPO  Use a custom framework fork instead of upstream
                     (also settable as $DOTFILES_FORK)

Re-running on a second Mac adds hosts/<hostname>.nix to the existing private
profile. Existing legacy profiles keep their current layout.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOSTNAME="$2"; shift 2 ;;
    --user) USER_NAME="$2"; shift 2 ;;
    --fork) FORK="$2"; shift 2 ;;
    --fork=*) FORK="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ -n "$FORK" ]] || FORK="${DOTFILES_FORK:-}"

if [[ ! "$HOSTNAME" =~ ^[A-Za-z0-9_-]+$ || ! "$USER_NAME" =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "Unsupported hostname or username for generated Nix configuration." >&2
  exit 1
fi

# Normalize a GitHub remote or flake reference to OWNER/REPO, or print nothing.
github_slug() {
  local value="$1" path
  case "$value" in
    github:*/*)
      printf '%s\n' "${value#github:}"
      ;;
    git@github.com:*/*)
      path="${value#git@github.com:}"
      printf '%s\n' "${path%.git}"
      ;;
    https://github.com/*/* | ssh://git@github.com/*/*)
      path="${value#*github.com/}"
      printf '%s\n' "${path%.git}"
      ;;
    */*)
      printf '%s\n' "${value%.git}"
      ;;
  esac
}

framework_ref() {
  local slug

  if [[ -z "$FORK" ]]; then
    printf '%s\n' "$UPSTREAM_REF"
    return 0
  fi

  slug="$(github_slug "$FORK")"
  if [[ ! "$slug" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid framework fork '$FORK' — expected OWNER/REPO or a GitHub URL." >&2
    return 1
  fi

  printf 'github:%s\n' "$slug"
}

# Existing legacy profiles keep the host module shape they already understand.
write_legacy_host_file() {
  mkdir -p "$PRIVATE_ROOT/hosts"
  cat > "$PRIVATE_ROOT/hosts/$HOSTNAME.nix" <<EOF
# Host identity for $HOSTNAME — generated by \`setup-private-host\`.
# Yours to edit: add machine-specific casks, packages and overrides here.
{ inputs, ... }:

let
  user = "$USER_NAME";
in
{
  nix-homebrew = {
    enable = true;
    enableRosetta = true;
    user = user;
    autoMigrate = true;
  };

  home-manager = {
    useGlobalPkgs = true;
    useUserPackages = true;
    backupFileExtension = "hm-backup";
    extraSpecialArgs = { inherit user; };

    users.\${user}.imports = [
      inputs.dotfiles.darwinModules.homeEnvironment
      ../home.nix
    ];
  };

  _module.args.user = user;
}
EOF
}

# Modular profiles reuse the same readable host template as first-run creation.
write_modular_host_file() {
  local content
  [[ -f "$HOST_TEMPLATE" ]] || {
    echo "Private-profile host template not found at $HOST_TEMPLATE" >&2
    return 1
  }

  content="$(cat "$HOST_TEMPLATE")"
  content="${content//@HOSTNAME@/$HOSTNAME}"
  content="${content//@USER@/$USER_NAME}"

  mkdir -p "$PRIVATE_ROOT/hosts"
  printf '%s\n' "$content" > "$PRIVATE_ROOT/hosts/$HOSTNAME.nix"
}

write_host_file() {
  if [[ "$(private_profile_layout "$PRIVATE_ROOT")" == "modular" ]]; then
    write_modular_host_file
  else
    write_legacy_host_file
  fi
}

# Does this private flake build its host list from the hosts/ directory? If so a
# new machine needs no flake edit; dropping in hosts/<name>.nix is sufficient.
flake_is_host_plural() {
  grep -q 'builtins.readDir ./hosts' "$PRIVATE_ROOT/flake.nix" 2>/dev/null
}

add_host_to_existing_profile() {
  if [[ -f "$PRIVATE_ROOT/hosts/$HOSTNAME.nix" ]] \
     || grep -q "darwinConfigurations\.\"${HOSTNAME}\"" "$PRIVATE_ROOT/flake.nix"; then
    echo "Private configuration already defines '$HOSTNAME' at $PRIVATE_ROOT"
    return 0
  fi

  write_home_nix_stub "$PRIVATE_ROOT/home.nix"
  write_host_file

  if flake_is_host_plural; then
    echo "Added host '$HOSTNAME' to $PRIVATE_ROOT"
    echo "  hosts/$HOSTNAME.nix written for user '$USER_NAME'"

    # R2: git+file evaluation excludes untracked files, so stage the new host.
    if git -C "$PRIVATE_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$PRIVATE_ROOT" add "hosts/$HOSTNAME.nix" home.nix 2>/dev/null || true
      echo "  staged (not committed — review and commit yourself)"
    fi

    echo
    echo "Next:  dot rebuild"
    return 0
  fi

  echo "Private flake exists at $PRIVATE_ROOT but has no host '$HOSTNAME'," >&2
  echo "and it predates the hosts/-directory layout. Wrote the host file, but" >&2
  echo "the older flake cannot discover it automatically. Add this block to" >&2
  echo "flake.nix yourself (the flake is yours, so this script will not rewrite it):" >&2
  echo >&2
  cat >&2 <<EOF
    darwinConfigurations."$HOSTNAME" = nix-darwin.lib.darwinSystem {
      system = "$(nix_system)";
      specialArgs = { inherit inputs self; };
      modules = [
        dotfiles.darwinModules.coreSystem
        nix-homebrew.darwinModules.nix-homebrew
        home-manager.darwinModules.home-manager
        ./hosts/$HOSTNAME.nix
      ];
    };
EOF
}

create_fresh_profile() {
  local dotfiles_ref system

  [[ -x "$GENERATOR" || -f "$GENERATOR" ]] || {
    echo "Private-profile generator not found at $GENERATOR" >&2
    return 1
  }

  dotfiles_ref="$(framework_ref)"
  system="$(nix_system)"

  if [[ "$dotfiles_ref" == "$UPSTREAM_REF" ]]; then
    echo "Using public framework: $dotfiles_ref"
  else
    echo "Using custom framework: $dotfiles_ref"
  fi

  # The renderer refuses non-empty destinations. Generate first, then initialize
  # Git and stage the source before locking because git-backed flakes exclude
  # untracked files from evaluation.
  bash "$GENERATOR" \
    --root "$PRIVATE_ROOT" \
    --host "$HOSTNAME" \
    --user "$USER_NAME" \
    --framework "$dotfiles_ref" \
    --system "$system"

  git init "$PRIVATE_ROOT" >/dev/null
  (
    cd "$PRIVATE_ROOT"
    git add .
    nix flake lock
    git add flake.lock
    git commit -m "Configure $HOSTNAME host" >/dev/null
  )

  echo
  echo "Private configuration created at $PRIVATE_ROOT"
  echo "  Applications: apps/"
  echo "  macOS:        macos/"
  echo "  Home Manager: home/"
  echo "  This Mac:     hosts/$HOSTNAME.nix"
  echo
  echo "Review README.md before changing the profile."
  echo "Second Mac? Clone this private repo there and run setup-private-host again."
}

if [[ -e "$PRIVATE_ROOT/flake.nix" ]]; then
  add_host_to_existing_profile
  exit 0
fi

create_fresh_profile
