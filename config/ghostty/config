# Ghostty Terminal Configuration
# Modern, fast terminal emulator settings for development

# Font configuration
font-family = JetBrains Mono NF
font-size = 14

# Window configuration
window-width = 140
window-height = 40
window-padding-x = 8
window-padding-y = 8
window-decoration = false
window-theme = dark

# Cursor configuration
cursor-style = bar
cursor-style-blink = false
cursor-color = #f8f8f2

# Color scheme (Dracula-like)
foreground = #f8f8f2
background = #282a36

# Regular colors
palette = 0=#000000
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2

# Bright colors
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff

# Selection colors
selection-foreground = #282a36
selection-background = #f8f8f2

# Scrollback
scrollback-limit = 10000

# Confirm before closing with running processes
confirm-close-surface = false

# Key bindings
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
