#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed, skipping secret scan"
  exit 0
fi

gitleaks detect \
  --source . \
  --config .gitleaks.toml \
  --redact \
  --no-git