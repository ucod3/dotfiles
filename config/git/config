[user]
  # Set per-machine via .local/identity.nix (preferred — see lib/local.nix),
  # which generates ~/.config/git/config-local through the include below.
  # Or: git config --global user.name "Your Name" / user.email "you@email"

[include]
  # Machine-local identity written by Home Manager from .local/identity.nix
  # (missing include files are silently ignored by git)
  path = config-local

[core]
  excludesfile = ~/.config/git/.gitignore
  editor = nvim
  autocrlf = input
  fsmonitor = true

[init]
  defaultBranch = main

[merge]
  tool = nvimdiff

[color]
  ui = auto

[push]
  default = simple

[rebase]
  autoStash = true

[branch]
  autoSetupRebase = always

[pull]
  rebase = true

[commit]
  verbose = true