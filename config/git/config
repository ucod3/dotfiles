[user]
  name = Usman Butt
  email = usman.butt@outlook.com

[core]
  excludesfile = ~/.config/git/.gitignore
  editor = nvim
  autocrlf = input
  fsmonitor = true

[init]
  defaultBranch = main

[merge]
  tool = nvimdiff

[color]
  ui = auto

[push]
  default = simple

[rebase]
  autoStash = true

[branch]
  autoSetupRebase = always

[pull]
  rebase = true

[commit]
  verbose = true