[user]
  # Set per-machine via .local/identity.nix (preferred — see lib/local.nix),
  # which generates ~/.config/git/config-local through the include below.
  # Or: git config --global user.name "Your Name" / user.email "you@email"

[include]
  # Machine-local identity written by Home Manager from .local/identity.nix
  # (missing include files are silently ignored by git)
  path = config-local

[include]
  # Workflow opinions — editor, merge tool, rebase-by-default and friends.
  # Home Manager writes this file ONLY when
  # `dotfiles.home.git.opinionatedDefaults.enable` is set; without it the
  # include resolves to nothing and git keeps its own defaults.
  #
  # This split exists because the settings it holds change what standard git
  # commands DO — `git pull` rebasing instead of merging, `git commit` opening
  # Neovim — and a framework must not impose a workflow on a fork (ADR-011).
  path = config-opinionated

[core]
  excludesfile = ~/.config/git/.gitignore
  autocrlf = input

[init]
  defaultBranch = main

[color]
  ui = auto
