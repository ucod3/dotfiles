[user]
  # Set per-machine: git config --global user.name "Your Name"
  #                  git config --global user.email "your@email.com"
  # Or set here for a personal dotfiles fork

[core]
  excludesfile = ~/.config/git/.gitignore
  editor = nvim
  autocrlf = input
  fsmonitor = true

[init]
  defaultBranch = main

[merge]
  tool = nvimdiff

[color]
  ui = auto

[push]
  default = simple

[rebase]
  autoStash = true

[branch]
  autoSetupRebase = always

[pull]
  rebase = true

[commit]
  verbose = true